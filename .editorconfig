root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

tab_width = 2
indent_size = 2
indent_style = space
max_line_length = 120

[*.{lis,md}]
max_line_length = 100

[{*.go,*.pkl,Opkgfile,PklProject}]
tab_width = 2
indent_size = 2
# formatting is handled by pkl format
# Go code is generated by Lisette
max_line_length = off
