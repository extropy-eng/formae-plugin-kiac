// Plugin name used as the directory name and binary name.
name = "kiac"

version = "0.1.0"

// Namespace appears in resource type IDs as the uppercase prefix.
// format: <NAMESPACE>::<Module>::<Resource>.
namespace = "KIAC"

summary = "Declarative configuration for running Kubernetes clusters on macOS using kiac"

description = "A formae plugin for running Kubernetes clusters on macOS using Apple containers."

category = "containers"

// SPDX license identifier
// (must be one of: Apache-2.0, BSD-3-Clause, MIT, MPL-2.0 for the public Formae Hub).
license = "MIT"

minFormaeVersion = "0.90.5"

output {
  renderer = new JsonRenderer {}
}
