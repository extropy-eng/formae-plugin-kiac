// Plugin name used as the directory name and binary name.
name = "kiac"

version = "0.1.0"

// Namespace appears in resource type IDs as the uppercase prefix: <NAMESPACE>::<Module>::<Resource>.
namespace = "KIAC"

summary = "Declarative management of local Kubernetes clusters on macOS"

description = """
  This formae plugin allows the declarative configuration of local Kubernetes clusters \
  with Pkl. These clusters are operated and managed by kiac using Apple containers on macOS.
"""

category = "containers"

// SPDX license identifier (must be one of: Apache-2.0, BSD-3-Clause, MIT, MPL-2.0 for the public Formae Hub).
license = "MIT"

minFormaeVersion = "0.90.5"

output {
  renderer = new JsonRenderer {}
}
