import "go:encoding/json"
import "go:github.com/platform-engineering-labs/formae/pkg/plugin/resource"

fn raw_message(text: string) -> mut json.RawMessage {
  let mut encoded = (text as Slice<byte>).clone()
  json.RawMessage(encoded)
}

/// Failure is an internal error that already knows its formae error code.
#[allow(unused_struct_field)]
struct Failure { code: resource.OperationErrorCode, message: string }

impl Failure {
  fn Error(self) -> string {
    self.message
  }
}

fn fail(code: resource.OperationErrorCode, message: string) -> Failure {
  Failure { code, message }
}

