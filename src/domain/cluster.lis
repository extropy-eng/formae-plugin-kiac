pub struct MountSpec {
  pub source: string,
  pub target: string,
  pub readonly: bool,
}

pub struct PortMappingSpec {
  pub host_ip: string,
  pub host_port: int,
  pub container_port: int,
  pub protocol: string,
}

pub struct NodeSpec {
  pub id: string,
  pub cluster_name: string,
  pub name: string,
  pub state: string,
}

pub struct Node {
  pub name: string,
  pub state: string,
  pub ip: string,
  pub image: string,
  pub created: string,
}

#[equality]
pub struct Cluster {
  pub name: string,
  pub status: string,
  pub running_nodes: int,
  pub total_nodes: int,
  pub k8s_version: string,
  pub created: string,
  pub nodes: Slice<Node>,
}

#[equality]
pub struct ClusterSpec {
  pub name: string,
  pub distro: string,
  pub cni: string,
  pub workers: int,
  pub cpus: string,
  pub memory: string,
  pub cp_memory: string,
  pub k8s_version: string,
  pub image: string,
  pub kernel: string,
  pub ip_family: string,
  pub observability: bool,
  pub gpu_workers: int,
  pub gpu_image: string,
  pub gpu_disk_size: string,
  pub gpu_resource_driver: string,
  pub gateway: bool,
  pub no_edge_proxy: bool,
  pub no_lb: bool,
  pub no_metrics: bool,
  pub no_storage: bool,
  pub wait: string,
  pub dns: Slice<string>,
  pub mounts: Slice<MountSpec>,
  pub publish: Slice<PortMappingSpec>,
}

pub enum NodePower {
  Running,
  Stopped,
}

pub fn node_power_for(state: string) -> Option<NodePower> {
  match state {
    "running" => Some(NodePower.Running),
    "stopped" => Some(NodePower.Stopped),
    _ => None,
  }
}

pub fn is_ready(cluster: Cluster) -> bool {
  cluster.total_nodes > 0 && cluster.running_nodes == cluster.total_nodes
}
