#[test("cluster equality includes nested node values")]
fn cluster_equality_includes_nodes() {
  let node = Node {
    name: "cp",
    state: "running",
    ip: "10.0.0.1",
    image: "img",
    created: "2026-10-04T03:18:35Z",
  }
  let actual = Cluster {
    name: "dev",
    status: "1/1 running",
    running_nodes: 1,
    total_nodes: 1,
    k8s_version: "v1.37.0-k3s1",
    created: "2026-10-04T03:18:35Z",
    nodes: [node],
  }
  assert actual.equals(Cluster { nodes: [node], ..actual })
}

#[test("running and stopped map to node power")]
fn known_node_states_map_to_power() {
  assert node_power_for("running") == Some(NodePower.Running)
  assert node_power_for("stopped") == Some(NodePower.Stopped)
}

#[test("an unknown node state has no power mapping")]
fn unknown_node_state_has_no_power() {
  assert node_power_for("paused") == None
  assert node_power_for("") == None
}
