import "go:encoding/json"
import "go:github.com/platform-engineering-labs/formae/pkg/plugin/resource"

fn raw_message(text: string) -> mut json.RawMessage {
  let mut encoded = (text as Slice<byte>).clone()
  json.RawMessage(encoded)
}

/// Failure is an internal error that already knows its formae error code.
#[allow(unused_struct_field)]
struct Failure { code: resource.OperationErrorCode, message: string }

impl Failure {
  fn Error(self) -> string {
    self.message
  }
}

fn fail(code: resource.OperationErrorCode, message: string) -> Failure {
  Failure { code, message }
}

// ---------- target configuration ----------

#[json]
struct TargetConfig {
  #[json("KiacPath")]
  kiac_path: string,
  #[json("ContainerPath")]
  container_path: string,
  #[json("DefaultWaitSeconds")]
  default_wait_seconds: int,
  #[json("StatusTimeoutSeconds")]
  status_timeout_seconds: int,
}

const DEFAULT_STATUS_TIMEOUT_SECONDS = 10

fn non_empty(value: string, fallback: string) -> string {
  if value.is_empty() { fallback } else { value }
}

fn positive(value: int, fallback: int) -> int {
  if value > 0 { value } else { fallback }
}

fn parse_target(raw: json.RawMessage) -> Result<TargetConfig, Failure> {
  let mut parsed = TargetConfig { .. }
  if !raw.0.is_empty() {
    json
      .Unmarshal(raw.0, &parsed)
      .map_err(|e| {
        fail(
          resource.OperationErrorCodeInvalidRequest,
          "parse target config: " + e.Error(),
        )
      })?
  }
  Ok(
    TargetConfig {
      kiac_path: non_empty(parsed.kiac_path, "kiac"),
      container_path: non_empty(parsed.container_path, "container"),
      default_wait_seconds: positive(parsed.default_wait_seconds, 300),
      status_timeout_seconds: positive(
        parsed.status_timeout_seconds,
        DEFAULT_STATUS_TIMEOUT_SECONDS,
      ),
    },
  )
}
