import "go:bytes"
import "go:context"
import "go:encoding/json"
import "go:github.com/platform-engineering-labs/formae/pkg/plugin/resource"
import "go:os/exec"
import "go:strings"
import "go:time"

fn raw_message(text: string) -> mut json.RawMessage {
  let mut encoded = (text as Slice<byte>).clone()
  json.RawMessage(encoded)
}

/// Failure is an internal error that already knows its formae error code.
#[allow(unused_struct_field)]
struct Failure { code: resource.OperationErrorCode, message: string }

impl Failure {
  fn Error(self) -> string {
    self.message
  }
}

fn fail(code: resource.OperationErrorCode, message: string) -> Failure {
  Failure { code, message }
}

// ------- target configuration -------

#[json]
struct TargetConfig {
  #[json("KiacPath")]
  kiac_path: string,
  #[json("ContainerPath")]
  container_path: string,
  #[json("DefaultWaitSeconds")]
  default_wait_seconds: int,
  #[json("StatusTimeoutSeconds")]
  status_timeout_seconds: int,
}

const DEFAULT_STATUS_TIMEOUT_SECONDS = 10

fn non_empty(value: string, fallback: string) -> string {
  if value.is_empty() { fallback } else { value }
}

fn positive(value: int, fallback: int) -> int {
  if value > 0 { value } else { fallback }
}

fn parse_target(raw: json.RawMessage) -> Result<TargetConfig, Failure> {
  let mut parsed = TargetConfig { .. }
  if !raw.0.is_empty() {
    json
      .Unmarshal(raw.0, &parsed)
      .map_err(|e| {
        fail(
          resource.OperationErrorCodeInvalidRequest,
          f"parse target config: {e.Error()}",
        )
      })?
  }
  Ok(
    TargetConfig {
      kiac_path: non_empty(parsed.kiac_path, "kiac"),
      container_path: non_empty(parsed.container_path, "container"),
      default_wait_seconds: positive(parsed.default_wait_seconds, 300),
      status_timeout_seconds: positive(
        parsed.status_timeout_seconds,
        DEFAULT_STATUS_TIMEOUT_SECONDS,
      ),
    },
  )
}

// ---------- process runner ----------

struct ProcResult { stdout: string }

fn run_kiac(
  ctx: context.Context,
  target: TargetConfig,
  args: Slice<string>,
) -> Result<ProcResult, Failure> {
  let mut stdout = bytes.Buffer { .. }
  let mut stderr = bytes.Buffer { .. }

  let mut command = exec.CommandContext(ctx, target.kiac_path, args...)
  command.Stdout = Some(&stdout)
  command.Stderr = Some(&stderr)

  // A killed kiac can leave a child holding the output pipes open; without a
  // wait delay, Wait blocks past the context deadline until that child exits.
  if ctx.Deadline().is_some() { command.WaitDelay = time.Second }

  match command.Run() {
    Ok(_) => Ok(ProcResult { stdout: stdout.String() }),
    Err(err) => {
      let message = first_non_empty([stderr.String(), err.Error()])
      Err(fail(classify_error(message), message))
    },
  }
}

// -------- cluster operations --------

#[json(camel_case)]
struct KiacNode {
  name: string,
  state: string,
  ip: string,
  image: string,
  created: string,
}

#[json(camel_case)]
#[equality]
struct KiacCluster {
  name: string,
  status: string,
  running_nodes: int,
  total_nodes: int,
  k8s_version: string,
  created: string,
  nodes: Slice<KiacNode>,
}

fn list_clusters(
  ctx: context.Context,
  target: TargetConfig,
) -> Result<Slice<KiacCluster>, Failure> {
  let result = run_kiac(ctx, target, ["get", "clusters", "-o", "json"])?
  let output = strings.TrimSpace(result.stdout)
  if output == "" || output == "null" {
    Ok([])
  } else {
    let mut clusters: Slice<KiacCluster> = []
    json
      .Unmarshal(output as Slice<byte>, &clusters)
      .map_err(|e| {
        fail(
          resource.OperationErrorCodeGeneralServiceException,
          f"parse kiac clusters: {e.Error()}",
        )
      })?
    Ok(clusters)
  }
}

fn find_cluster_by_name(
  ctx: context.Context,
  target: TargetConfig,
  name: string,
) -> Result<Option<KiacCluster>, Failure> {
  list_clusters(ctx, target).map(|clusters| clusters.find(|c| c.name == name))
}

// ---------- shared helpers ----------

/// Split "<left>/<right>" on the first slash.
/// With no slash, left is empty and right is the whole id.
fn split_id(id: string) -> (string, string) {
  let parts = strings.SplitN(id, "/", 2)
  if parts.length() == 2 { (parts[0], parts[1]) } else { ("", id) }
}

fn first_non_empty(values: Slice<string>) -> string {
  for value in values {
    let trimmed = strings.TrimSpace(value)
    if trimmed != "" { return trimmed }
  }
  ""
}

fn classify_error(stderr: string) -> resource.OperationErrorCode {
  let rules = [
    (["already exist"], resource.OperationErrorCodeAlreadyExists),
    (["not found", "no such"], resource.OperationErrorCodeNotFound),
    (["timed out", "timeout"], resource.OperationErrorCodeServiceTimeout),
    (["permission", "denied"], resource.OperationErrorCodeAccessDenied),
  ]
  let lowercase_error = strings.ToLower(stderr)
  rules
    .find(|rule| rule.0.any(|needle| lowercase_error.contains(needle)))
    .map_or(resource.OperationErrorCodeGeneralServiceException, |rule| rule.1)
}
