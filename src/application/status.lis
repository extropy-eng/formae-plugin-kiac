import "go:context"
import "go:time"

import "domain"

impl Application {
  pub fn check_status(
    self: mut Ref<Application>,
    ctx: context.Context,
    target: domain.TargetConfig,
    request_id: string,
    native_id: string,
  ) -> StatusOutcome {
    let cluster_name = self.ops
      .get(request_id)
      .map_or(request_id, |operation| operation.cluster)
    let snapshot = self.ops
      .get(request_id)
      .map(|operation| operation.handle.snapshot())
    let expired = snapshot.map_or(false, |state| {
      time.Since(state.started_at) >
      time.Duration(target.default_wait_seconds as int64) * time.Second
    })

    let (probe_ctx, cancel) = context.WithTimeout(
      ctx,
      time.Duration(target.status_timeout_seconds as int64) * time.Second,
    )
    defer cancel()
    match self.reader.find_cluster(probe_ctx, target, cluster_name) {
      Ok(Some(cluster)) => {
        let resolved_id = outcome_id(native_id, cluster.name)
        if cluster.running_nodes == cluster.total_nodes {
          StatusOutcome.Success {
            native_id: resolved_id,
            properties: ResourceProperties.Cluster(cluster),
          }
        } else if expired {
          StatusOutcome.Failure { failure: timeout_failure(cluster_name) }
        } else {
          StatusOutcome.InProgress {
            native_id: resolved_id,
            message: cluster.status,
          }
        }
      },
      Ok(None) => match snapshot {
        Some(snapshot) if snapshot.done && snapshot.error.is_some() => {
          StatusOutcome.Failure {
            failure: domain.fail(
              domain.ErrorKind.GeneralServiceException,
              snapshot.error.unwrap_or(""),
            ),
          }
        },
        _ => {
          if expired {
            StatusOutcome.Failure { failure: timeout_failure(cluster_name) }
          } else {
            StatusOutcome.InProgress {
              native_id: outcome_id(native_id, cluster_name),
              message: f"waiting for cluster {cluster_name}",
            }
          }
        },
      },
      Err(failure) => {
        if expired {
          StatusOutcome.Failure { failure: timeout_failure(cluster_name) }
        } else {
          StatusOutcome.InProgress {
            native_id: outcome_id(native_id, cluster_name),
            message: failure.message,
          }
        }
      },
    }
  }
}

fn timeout_failure(cluster_name: string) -> domain.Failure {
  domain.fail(
    domain.ErrorKind.ServiceTimeout,
    f"cluster {cluster_name} did not converge",
  )
}

fn outcome_id(native_id: string, fallback: string) -> string {
  if native_id.is_empty() { fallback } else { native_id }
}
