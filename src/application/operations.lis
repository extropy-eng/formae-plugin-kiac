import "go:context"

import "domain"

impl Application {
  pub fn create_verification(
    self: Ref<Application>,
    spec: domain.VerificationSpec,
  ) -> Result<CreateOutcome, domain.Failure> {
    Ok(
      CreateOutcome {
        native_id: spec.cluster_name,
        request_id: "",
        status: CreateStatus.Success,
        message: "",
        properties: ResourceProperties.None,
      },
    )
  }

  pub fn delete_image(
    self: Ref<Application>,
    native_id: string,
  ) -> Result<DeleteOutcome, domain.Failure> {
    Ok(DeleteOutcome { native_id, no_op: true })
  }

  pub fn read_image(
    self: Ref<Application>,
    native_id: string,
  ) -> Result<ResourceProperties, domain.Failure> {
    let (cluster_name, image) = domain.split_id(native_id)
    Ok(ResourceProperties.Image(
      domain.Image { id: native_id, cluster_name, image },
    ))
  }

  pub fn create_image(
    self: mut Ref<Application>,
    ctx: context.Context,
    target: domain.TargetConfig,
    spec: domain.ImageSpec,
  ) -> Result<CreateOutcome, domain.Failure> {
    let (base_cluster, base_image) = if spec.cluster_name.is_empty() || spec.image.is_empty() {
      domain.split_id(spec.id)
    } else {
      (spec.cluster_name, spec.image)
    }
    let native_id = if spec.id.is_empty() {
      f"{base_cluster}/{base_image}"
    } else {
      spec.id
    }
    self.image_loader.load_image(ctx, target, base_cluster, base_image)?
    Ok(
      CreateOutcome {
        native_id,
        request_id: native_id,
        status: CreateStatus.Success,
        message: "",
        properties: ResourceProperties.Image(
          domain.Image {
            id: native_id,
            cluster_name: base_cluster,
            image: base_image,
          },
        ),
      },
    )
  }

  pub fn delete_gpu_compat(
    self: mut Ref<Application>,
    ctx: context.Context,
    target: domain.TargetConfig,
    native_id: string,
  ) -> Result<DeleteOutcome, domain.Failure> {
    let (cluster_name, namespace) = domain.split_id(native_id)
    self.gpu_compat.set_gpu_compat(
      ctx,
      target,
      cluster_name,
      namespace,
      false,
      false,
    )?
    Ok(DeleteOutcome { native_id, no_op: false })
  }

  pub fn update_gpu_compat(
    self: mut Ref<Application>,
    ctx: context.Context,
    target: domain.TargetConfig,
    native_id: string,
    desired: domain.GpuCompatSpec,
  ) -> Result<UpdateOutcome, domain.Failure> {
    let (base_cluster, base_namespace) = domain.split_id(native_id)
    let cluster_name = if desired.cluster_name.is_empty() {
      base_cluster
    } else {
      desired.cluster_name
    }
    let namespace = if desired.namespace.is_empty() {
      base_namespace
    } else {
      desired.namespace
    }
    self.gpu_compat.set_gpu_compat(
      ctx,
      target,
      cluster_name,
      namespace,
      desired.enabled,
      false,
    )?
    Ok(
      UpdateOutcome {
        native_id,
        properties: ResourceProperties.GpuCompat(
          domain.GpuCompat {
            id: native_id,
            cluster_name,
            namespace,
            enabled: desired.enabled,
          },
        ),
      },
    )
  }

  pub fn read_gpu_compat(
    self: Ref<Application>,
    native_id: string,
  ) -> Result<ResourceProperties, domain.Failure> {
    let (cluster_name, namespace) = domain.split_id(native_id)
    Ok(ResourceProperties.GpuCompatState(
      domain.GpuCompatState { id: native_id, cluster_name, namespace },
    ))
  }

  pub fn create_gpu_compat(
    self: mut Ref<Application>,
    ctx: context.Context,
    target: domain.TargetConfig,
    spec: domain.GpuCompatSpec,
  ) -> Result<CreateOutcome, domain.Failure> {
    let (cluster_name, namespace) = if !spec.cluster_name.is_empty() && !spec.namespace.is_empty() {
      (spec.cluster_name, spec.namespace)
    } else {
      domain.split_id(spec.id)
    }
    let native_id = if spec.id.is_empty() {
      f"{cluster_name}/{namespace}"
    } else {
      spec.id
    }
    self.gpu_compat.set_gpu_compat(
      ctx,
      target,
      cluster_name,
      namespace,
      spec.enabled,
      spec.rotate_certificate,
    )?
    Ok(
      CreateOutcome {
        native_id,
        request_id: native_id,
        status: CreateStatus.Success,
        message: "",
        properties: ResourceProperties.GpuCompat(
          domain.GpuCompat {
            id: native_id,
            cluster_name,
            namespace,
            enabled: spec.enabled,
          },
        ),
      },
    )
  }
}
