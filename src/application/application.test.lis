import "go:context"
import "go:time"

import "domain"
import "ports"

struct FakeHandle {}

impl FakeHandle {
  fn snapshot(self: FakeHandle) -> domain.ProcessSnapshot {
    domain.ProcessSnapshot { done: true, error: None, started_at: time.Now() }
  }
}

#[test("the registry stores a handle under its cluster")]
fn registry_stores_handle_by_cluster() {
  let mut registry = OperationRegistry.new()
  let handle: ports.OperationHandle = FakeHandle { .. }
  registry.put("dev", handle)
  let found = registry.get("dev")
  assert found.is_some()
  match found {
    Some(operation) => {
      assert operation.cluster == "dev"
    },
    None => {
      assert false
    },
  }
}

#[test("the registry returns none for an unknown cluster")]
fn registry_returns_none_for_unknown_cluster() {
  let mut registry = OperationRegistry.new()
  assert registry.get("missing").is_none()
}

struct FakeClusterReader { clusters: Slice<domain.Cluster> }

impl FakeClusterReader {
  fn list_clusters(
    self: FakeClusterReader,
    _ctx: context.Context,
    _target: domain.TargetConfig,
  ) -> Result<Slice<domain.Cluster>, domain.Failure> {
    Ok(self.clusters)
  }

  fn find_cluster(
    self: FakeClusterReader,
    _ctx: context.Context,
    _target: domain.TargetConfig,
    name: string,
  ) -> Result<Option<domain.Cluster>, domain.Failure> {
    Ok(self.clusters.find(|cluster| cluster.name == name))
  }
}

struct FakeLifecycle {}

impl FakeLifecycle {
  fn start_create_cluster(
    self: FakeLifecycle,
    _target: domain.TargetConfig,
    _spec: domain.ClusterSpec,
  ) -> ports.OperationHandle {
    FakeHandle { .. }
  }

  fn start_resume_cluster(
    self: FakeLifecycle,
    _target: domain.TargetConfig,
    _cluster: string,
  ) -> ports.OperationHandle {
    FakeHandle { .. }
  }

  fn delete_cluster(
    self: FakeLifecycle,
    _ctx: context.Context,
    _target: domain.TargetConfig,
    _name: string,
  ) -> Result<(), domain.Failure> {
    Ok(())
  }
}

