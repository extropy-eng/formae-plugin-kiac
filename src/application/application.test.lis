struct FakeVerifier {}

impl FakeVerifier {
  fn verify_cluster(
    self: FakeVerifier,
    _ctx: context.Context,
    _target: domain.TargetConfig,
    _cluster: string,
  ) -> Result<domain.Verification, domain.Failure> {
    Ok(domain.Verification { .. })
  }
}

fn app_with_clusters(clusters: Slice<domain.Cluster>) -> mut Application {
  new(
    FakeClusterReader { clusters },
    FakeLifecycle { .. },
    FakeNodePower { .. },
    FakeImageLoader { .. },
    FakeGpuCompat { .. },
    FakeVerifier { .. },
  )
}

#[test("a new application starts with an empty operation registry")]
fn new_application_has_empty_registry() {
  let mut app = app_with_clusters([])
  assert app.ops.get("dev").is_none()
}

#[test("create outcomes compare as complete values")]
fn create_outcomes_compare_as_values() {
  let actual = CreateOutcome {
    native_id: "dev",
    request_id: "dev",
    status: CreateStatus.InProgress,
    message: "creating cluster dev",
    properties: ResourceProperties.None,
  }
  assert actual.equals(CreateOutcome { ..actual })
}
