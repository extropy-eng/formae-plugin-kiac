import "go:context"
import "go:time"

import "domain"

#[test("a new application starts with an empty operation registry")]
fn new_application_has_empty_registry() {
  let mut app = app_with_clusters([])
  assert app.ops.get("dev").is_none()
}

#[test("create outcomes compare as complete values")]
fn create_outcomes_compare_as_values() {
  let actual = CreateOutcome {
    native_id: "dev",
    request_id: "dev",
    status: CreateStatus.InProgress,
    message: "creating cluster dev",
    properties: ResourceProperties.None,
  }
  assert actual.equals(CreateOutcome { ..actual })
}

#[test("a ready cluster status is a success value")]
fn ready_cluster_status_is_success() {
  let mut app = app_with_clusters([ready_cluster()])
  let actual = app.check_status(context.Background(), target(), "dev", "")
  let expected = StatusOutcome.Success {
    native_id: "dev",
    properties: ResourceProperties.Cluster(ready_cluster()),
  }
  assert actual.equals(expected)
}

#[test("a busy cluster status is in progress")]
fn busy_cluster_status_is_in_progress() {
  let mut app = app_with_clusters([busy_cluster()])
  let actual = app.check_status(context.Background(), target(), "dev", "")
  let expected = StatusOutcome.InProgress {
    native_id: "dev",
    message: "1/2 running",
  }
  assert actual.equals(expected)
}

#[test("a failed background create surfaces its stderr")]
fn failed_background_create_surfaces_stderr() {
  let mut app = app_with_clusters([])
  app.ops.put(
    "dev",
    FakeHandle {
      state: domain.ProcessSnapshot {
        done: true,
        error: Some("boom: cannot create"),
        ..,
      },
      ..,
    },
  )
  let actual = app.check_status(context.Background(), target(), "dev", "")
  let StatusOutcome.Failure { failure } = actual else {
    assert false
    return
  }
  assert failure.kind == domain.ErrorKind.GeneralServiceException
  assert failure.message.contains("boom")
}

struct FailingReader {}

impl FailingReader {
  fn list_clusters(
    self: FailingReader,
    _ctx: context.Context,
    _target: domain.TargetConfig,
  ) -> Result<Slice<domain.Cluster>, domain.Failure> {
    Err(unreachable())
  }

  fn find_cluster(
    self: FailingReader,
    _ctx: context.Context,
    _target: domain.TargetConfig,
    _name: string,
  ) -> Result<Option<domain.Cluster>, domain.Failure> {
    Err(unreachable())
  }
}

fn unreachable() -> domain.Failure {
  domain.fail(domain.ErrorKind.GeneralServiceException, "unreachable")
}

fn app_with_kiac_reader_failure() -> mut Application {
  new(
    FailingReader { .. },
    FakeLifecycle { .. },
    FakeNodePower { .. },
    FakeImageLoader { .. },
    FakeGpuCompat { .. },
    FakeVerifier { .. },
  )
}

#[test("a busy cluster past its convergence deadline times out")]
fn busy_cluster_past_deadline_times_out() {
  let mut app = app_with_clusters([busy_cluster()])
  app.ops.put(
    "dev",
    FakeHandle {
      state: domain.ProcessSnapshot {
        done: false,
        error: None,
        started_at: time.Now().Add(-time.Hour),
      },
      ..,
    },
  )
  let actual = app.check_status(context.Background(), target(), "dev", "")
  let StatusOutcome.Failure { failure } = actual else {
    assert false
    return
  }
  assert failure.kind == domain.ErrorKind.ServiceTimeout
}

#[test("a probe failure before the deadline remains in progress")]
fn probe_failure_before_deadline_remains_in_progress() {
  let mut app = app_with_kiac_reader_failure()
  let actual = app.check_status(context.Background(), target(), "dev", "")
  let StatusOutcome.InProgress { message, .. } = actual else {
    assert false
    return
  }
  assert message.contains("unreachable")
}

#[test("a missing cluster before the deadline reports waiting")]
fn missing_cluster_before_deadline_reports_waiting() {
  let mut app = app_with_clusters([])
  app.ops.put(
    "dev",
    FakeHandle {
      state: domain.ProcessSnapshot {
        done: false,
        error: None,
        started_at: time.Now(),
      },
      ..,
    },
  )
  let actual = app.check_status(context.Background(), target(), "dev", "")
  let StatusOutcome.InProgress { message, .. } = actual else {
    assert false
    return
  }
  assert message == "waiting for cluster dev"
}

#[test("an expired busy cluster says it did not converge")]
fn expired_cluster_message() {
  let mut app = app_with_clusters([busy_cluster()])
  app.ops.put(
    "dev",
    FakeHandle {
      state: domain.ProcessSnapshot {
        done: false,
        error: None,
        started_at: time.Now().Add(-time.Hour),
      },
      ..,
    },
  )
  let actual = app.check_status(context.Background(), target(), "dev", "")
  let StatusOutcome.Failure { failure } = actual else {
    assert false
    return
  }
  assert failure.message == "cluster dev did not converge"
}

#[test("a resume status keeps the nonce native id")]
fn resume_status_keeps_nonce_native_id() {
  let mut app = app_with_clusters([ready_cluster()])
  let actual = app.check_status(context.Background(), target(), "dev", "dev/n1")
  let StatusOutcome.Success { native_id, .. } = actual else {
    assert false
    return
  }
  assert native_id == "dev/n1"
}

#[test("an empty status native id falls back to the cluster name")]
fn empty_status_native_id_falls_back() {
  let mut app = app_with_clusters([ready_cluster()])
  let actual = app.check_status(context.Background(), target(), "dev", "")
  let StatusOutcome.Success { native_id, .. } = actual else {
    assert false
    return
  }
  assert native_id == "dev"
}
