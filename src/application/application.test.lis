import "go:context"
import "go:time"

import "domain"
import "ports"

#[test("a new application starts with an empty operation registry")]
fn new_application_has_empty_registry() {
  let mut app = app_with_clusters([])
  assert app.ops.get("dev").is_none()
}

#[test("create outcomes compare as complete values")]
fn create_outcomes_compare_as_values() {
  let actual = CreateOutcome {
    native_id: "dev",
    request_id: "dev",
    status: CreateStatus.InProgress,
    message: "creating cluster dev",
    properties: ResourceProperties.None,
  }
  assert actual.equals(CreateOutcome { ..actual })
}

#[test("creating an existing cluster is idempotent")]
fn create_existing_cluster_is_idempotent() -> Result<(), error> {
  let fake = FakeClusterReader { clusters: [ready_cluster()], .. }
  let mut app = app_with_ports(fake)
  let actual = app.create_cluster(
    context.Background(),
    target(),
    domain.ClusterSpec { name: "dev", .. },
  )?
  let expected = CreateOutcome {
    native_id: "dev",
    request_id: "dev",
    status: CreateStatus.Success,
    message: "",
    properties: ResourceProperties.Cluster(ready_cluster()),
  }
  assert actual.equals(expected)
  assert fake.start_calls.is_empty()
  Ok(())
}

#[test("creating a missing cluster starts an operation")]
fn create_missing_cluster_starts_operation() -> Result<(), error> {
  let fake = FakeClusterReader { clusters: [], .. }
  let mut app = app_with_ports(fake)
  let actual = app.create_cluster(
    context.Background(),
    target(),
    domain.ClusterSpec { name: "dev", .. },
  )?
  assert actual.native_id == "dev"
  assert actual.status == CreateStatus.InProgress
  assert app.ops.get("dev").is_some()
  Ok(())
}

#[test("creating a cluster requires a name")]
fn create_cluster_requires_name() {
  let mut app = app_with_clusters([])
  let failure = expect_failure(app.create_cluster(
    context.Background(),
    target(),
    domain.ClusterSpec { .. },
  ))
  assert failure.kind == domain.ErrorKind.InvalidRequest
}

struct RecordingLifecycle { deleted: mut Ref<mut Slice<string>> }

impl RecordingLifecycle {
  fn start_create_cluster(
    self: RecordingLifecycle,
    _target: domain.TargetConfig,
    _spec: domain.ClusterSpec,
  ) -> ports.OperationHandle {
    FakeHandle { .. }
  }

  fn start_resume_cluster(
    self: RecordingLifecycle,
    _target: domain.TargetConfig,
    _cluster: string,
  ) -> ports.OperationHandle {
    FakeHandle { .. }
  }

  fn delete_cluster(
    self: mut Ref<RecordingLifecycle>,
    _ctx: context.Context,
    _target: domain.TargetConfig,
    name: string,
  ) -> Result<(), domain.Failure> {
    self.deleted.* = self.deleted.*.append(name)
    Ok(())
  }
}

fn app_with_cluster_lifecycle(
  clusters: Slice<domain.Cluster>,
) -> (mut Application, RecordingLifecycle) {
  let mut deleted: Slice<string> = []
  let mut lifecycle = RecordingLifecycle { deleted: &deleted }
  (
    new(
      FakeClusterReader { clusters, start_calls: [] },
      &lifecycle,
      FakeNodePower { .. },
      FakeImageLoader { .. },
      FakeGpuCompat { .. },
      FakeVerifier { .. },
    ),
    lifecycle,
  )
}

#[test("deleting a missing cluster succeeds")]
fn delete_missing_cluster_succeeds() -> Result<(), error> {
  let mut app = app_with_clusters([])
  let actual = app.delete_cluster(context.Background(), target(), "gone")?
  assert actual == DeleteOutcome { native_id: "gone", no_op: false }
  Ok(())
}

#[test("deleting an existing cluster invokes the lifecycle port")]
fn delete_existing_cluster_invokes_lifecycle() -> Result<(), error> {
  let (app, fake) = app_with_cluster_lifecycle([ready_cluster()])
  let mut app = app
  let actual = app.delete_cluster(context.Background(), target(), "dev")?
  assert actual == DeleteOutcome { native_id: "dev", no_op: false }
  assert fake.deleted.*.equals(["dev"])
  Ok(())
}

#[test("a ready cluster status is a success value")]
fn ready_cluster_status_is_success() {
  let mut app = app_with_clusters([ready_cluster()])
  let actual = app.check_status(context.Background(), target(), "dev", "")
  let expected = StatusOutcome.Success {
    native_id: "dev",
    properties: ResourceProperties.Cluster(ready_cluster()),
  }
  assert actual.equals(expected)
}

#[test("a busy cluster status is in progress")]
fn busy_cluster_status_is_in_progress() {
  let mut app = app_with_clusters([busy_cluster()])
  let actual = app.check_status(context.Background(), target(), "dev", "")
  let expected = StatusOutcome.InProgress {
    native_id: "dev",
    message: "1/2 running",
  }
  assert actual.equals(expected)
}

#[test("a failed background create surfaces its stderr")]
fn failed_background_create_surfaces_stderr() {
  let mut app = app_with_clusters([])
  app.ops.put(
    "dev",
    FakeHandle {
      state: domain.ProcessSnapshot {
        done: true,
        error: Some("boom: cannot create"),
        ..,
      },
      ..,
    },
  )
  let actual = app.check_status(context.Background(), target(), "dev", "")
  let StatusOutcome.Failure { failure } = actual else {
    assert false
    return
  }
  assert failure.kind == domain.ErrorKind.GeneralServiceException
  assert failure.message.contains("boom")
}

#[test("creating a node falls back to the native id")]
fn create_node_falls_back_to_native_id() -> Result<(), error> {
  let mut app = app_with_clusters([two_node_cluster()])
  let actual = app.create_node(
    context.Background(),
    target(),
    domain.NodeSpec { id: "dev/kiac-dev-worker-1", .. },
  )?
  assert actual.native_id == "dev/kiac-dev-worker-1"
  assert actual.status == CreateStatus.Success
  Ok(())
}

#[test("creating a node without its parent is a dependency failure")]
fn create_node_requires_parent() {
  let mut app = app_with_clusters([])
  let failure = expect_failure(app.create_node(
    context.Background(),
    target(),
    domain.NodeSpec { id: "dev/kiac-dev-worker-1", .. },
  ))
  assert failure ==
  domain.Failure {
    kind: domain.ErrorKind.DependencyFailure,
    message: "parent cluster not found: dev",
  }
}

#[test("reading a node returns the cluster and node values")]
fn read_node_returns_cluster_and_node() -> Result<(), error> {
  let mut app = app_with_clusters([two_node_cluster()])
  let actual = app.read_node(
    context.Background(),
    target(),
    "dev/kiac-dev-worker-1",
  )?
  let ResourceProperties.Node { cluster, node } = actual else {
    assert false
    return Ok(())
  }
  assert cluster == "dev"
  assert node == two_node_cluster().nodes[1]
  Ok(())
}

#[test("reading a missing cluster is NotFound")]
fn read_node_missing_cluster_is_not_found() {
  let mut app = app_with_clusters([])
  let failure = expect_failure(app.read_node(
    context.Background(),
    target(),
    "dev/missing",
  ))
  assert failure.kind == domain.ErrorKind.NotFound
}

struct RecordingNodePower { calls: mut Ref<mut Slice<string>> }

impl RecordingNodePower {
  fn set_node_power(
    self: mut Ref<RecordingNodePower>,
    _ctx: context.Context,
    _target: domain.TargetConfig,
    _cluster: string,
    _node: string,
    power: domain.NodePower,
  ) -> Result<(), domain.Failure> {
    let verb = match power {
      domain.NodePower.Running => "start",
      domain.NodePower.Stopped => "stop",
    }
    self.calls.* = self.calls.*.append(verb)
    Ok(())
  }
}

fn app_with_node_ports(
  clusters: Slice<domain.Cluster>,
) -> (mut Application, RecordingNodePower) {
  let mut calls: Slice<string> = []
  let mut node_power = RecordingNodePower { calls: &calls }
  (
    new(
      FakeClusterReader { clusters, start_calls: [] },
      FakeLifecycle { .. },
      &node_power,
      FakeImageLoader { .. },
      FakeGpuCompat { .. },
      FakeVerifier { .. },
    ),
    node_power,
  )
}

#[test("updating node power runs the matching verb")]
fn update_node_runs_matching_verb() -> Result<(), error> {
  let (app, fake) = app_with_node_ports([two_node_cluster()])
  let mut app = app
  let actual = app.update_node(
    context.Background(),
    target(),
    "dev/kiac-dev-worker-1",
    domain.NodeSpec { state: "running", .. },
    domain.NodeSpec {
      id: "dev/kiac-dev-worker-1",
      cluster_name: "dev",
      name: "kiac-dev-worker-1",
      state: "stopped",
    },
  )?
  assert actual.native_id == "dev/kiac-dev-worker-1"
  assert fake.calls.*.equals(["stop"])
  Ok(())
}

#[test("an unknown node state is an invalid request")]
fn update_node_unknown_state_is_invalid() {
  let mut app = app_with_clusters([two_node_cluster()])
  let failure = expect_failure(app.update_node(
    context.Background(),
    target(),
    "dev/cp",
    domain.NodeSpec { state: "running", .. },
    domain.NodeSpec { cluster_name: "dev", name: "cp", state: "paused", .. },
  ))
  assert failure ==
  domain.Failure {
    kind: domain.ErrorKind.InvalidRequest,
    message: "state must be running or stopped",
  }
}

#[test("updating a node survives a disappearing parent")]
fn update_node_survives_missing_parent() -> Result<(), error> {
  let (app, _fake) = app_with_node_ports([])
  let mut app = app
  let actual = app.update_node(
    context.Background(),
    target(),
    "dev/cp",
    domain.NodeSpec { state: "running", .. },
    domain.NodeSpec { cluster_name: "dev", name: "cp", state: "stopped", .. },
  )?
  assert actual.properties.equals(ResourceProperties.None)
  Ok(())
}

#[test("deleting a node is a no-op")]
fn delete_node_is_noop() -> Result<(), error> {
  let app = app_with_clusters([])
  let actual = app.delete_node("dev/cp")?
  assert actual == DeleteOutcome { native_id: "dev/cp", no_op: true }
  Ok(())
}

#[test("listing nodes uses the parent cluster")]
fn list_nodes_uses_parent_cluster() -> Result<(), error> {
  let mut app = app_with_clusters([two_node_cluster()])
  let actual = app.list_nodes(context.Background(), target(), "dev")?
  let expected = ["dev/kiac-dev-control-plane", "dev/kiac-dev-worker-1"]
  assert actual.equals(expected)
  Ok(())
}

#[test("listing nodes without a parent is empty")]
fn list_nodes_without_parent_is_empty() -> Result<(), error> {
  let mut app = app_with_clusters([two_node_cluster()])
  let actual = app.list_nodes(context.Background(), target(), "")?
  assert actual.is_empty()
  Ok(())
}

struct RecordingGpuCompat { calls: mut Ref<mut Slice<string>> }

impl RecordingGpuCompat {
  fn set_gpu_compat(
    self: mut Ref<RecordingGpuCompat>,
    _ctx: context.Context,
    _target: domain.TargetConfig,
    cluster: string,
    namespace: string,
    enabled: bool,
    rotate: bool,
  ) -> Result<(), domain.Failure> {
    let verb = if enabled { "enable" } else { "disable" }
    let rotation = if rotate && enabled { "rotate" } else { "no-rotate" }
    self.calls.* = self.calls.*.append(
      f"{verb} {cluster}/{namespace} {rotation}",
    )
    Ok(())
  }
}

fn app_with_fake_gpu() -> (mut Application, RecordingGpuCompat) {
  let mut calls: Slice<string> = []
  let mut gpu_compat = RecordingGpuCompat { calls: &calls }
  (
    new(
      FakeClusterReader { clusters: [], start_calls: [] },
      FakeLifecycle { .. },
      FakeNodePower { .. },
      FakeImageLoader { .. },
      &gpu_compat,
      FakeVerifier { .. },
    ),
    gpu_compat,
  )
}

#[test("creating GPU compatibility enables it")]
fn create_gpu_compat_enables() -> Result<(), error> {
  let (app, fake) = app_with_fake_gpu()
  let mut app = app
  let actual = app.create_gpu_compat(
    context.Background(),
    target(),
    domain.GpuCompatSpec {
      id: "dev/default",
      cluster_name: "dev",
      namespace: "default",
      enabled: true,
      rotate_certificate: true,
    },
  )?
  assert actual.native_id == "dev/default"
  assert actual.status == CreateStatus.Success
  assert fake.calls.*.equals(["enable dev/default rotate"])
  Ok(())
}

#[test("reading GPU compatibility returns only observable fields")]
fn read_gpu_compat_returns_observable_fields() -> Result<(), error> {
  let app = app_with_clusters([])
  let actual = app.read_gpu_compat("dev/default")?
  let ResourceProperties.GpuCompatState(state) = actual else {
    assert false
    return Ok(())
  }
  assert state ==
  domain.GpuCompatState {
    id: "dev/default",
    cluster_name: "dev",
    namespace: "default",
  }
  Ok(())
}

#[test("updating GPU compatibility disables it")]
fn update_gpu_compat_disables() -> Result<(), error> {
  let (app, fake) = app_with_fake_gpu()
  let mut app = app
  let actual = app.update_gpu_compat(
    context.Background(),
    target(),
    "dev/default",
    domain.GpuCompatSpec { enabled: false, .. },
  )?
  assert actual.native_id == "dev/default"
  assert fake.calls.*.equals(["disable dev/default no-rotate"])
  Ok(())
}

#[test("deleting GPU compatibility disables it")]
fn delete_gpu_compat_disables() -> Result<(), error> {
  let (app, fake) = app_with_fake_gpu()
  let mut app = app
  let actual = app.delete_gpu_compat(
    context.Background(),
    target(),
    "dev/default",
  )?
  assert actual == DeleteOutcome { native_id: "dev/default", no_op: false }
  assert fake.calls.*.equals(["disable dev/default no-rotate"])
  Ok(())
}

