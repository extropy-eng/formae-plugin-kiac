fn app_with_clusters(clusters: Slice<domain.Cluster>) -> mut Application {
  new(
    FakeClusterReader { clusters },
    FakeLifecycle { .. },
    FakeNodePower { .. },
    FakeImageLoader { .. },
    FakeGpuCompat { .. },
    FakeVerifier { .. },
  )
}

#[test("a new application starts with an empty operation registry")]
fn new_application_has_empty_registry() {
  let mut app = app_with_clusters([])
  assert app.ops.get("dev").is_none()
}

#[test("create outcomes compare as complete values")]
fn create_outcomes_compare_as_values() {
  let actual = CreateOutcome {
    native_id: "dev",
    request_id: "dev",
    status: CreateStatus.InProgress,
    message: "creating cluster dev",
    properties: ResourceProperties.None,
  }
  assert actual.equals(CreateOutcome { ..actual })
}

fn ready_cluster() -> domain.Cluster {
  domain.Cluster {
    name: "dev",
    status: "2/2 running",
    running_nodes: 2,
    total_nodes: 2,
    k8s_version: "v1.37.0-k3s1",
    created: "2026-10-04T03:18:35Z",
    nodes: [],
  }
}

fn target() -> domain.TargetConfig {
  domain.TargetConfig {
    kiac_path: "kiac",
    container_path: "container",
    default_wait_seconds: 300,
    status_timeout_seconds: 10,
  }
}

fn expect_failure<T>(result: Result<T, domain.Failure>) -> domain.Failure {
  match result {
    Err(failure) => failure,
    Ok(_) => domain.fail(domain.ErrorKind.InternalFailure, "expected failure"),
  }
}

#[test("reading a cluster returns its full observed value")]
fn read_cluster_returns_observed_value() -> Result<(), error> {
  let mut app = app_with_clusters([ready_cluster()])
  let actual = app.read_cluster(context.Background(), target(), "dev")?
  let expected = ResourceProperties.Cluster(ready_cluster())
  assert actual.equals(expected)
  Ok(())
}

#[test("reading a missing cluster returns NotFound")]
fn read_missing_cluster_returns_not_found() {
  let mut app = app_with_clusters([])
  let failure = expect_failure(app.read_cluster(
    context.Background(),
    target(),
    "gone",
  ))
  assert failure.kind == domain.ErrorKind.NotFound
}
