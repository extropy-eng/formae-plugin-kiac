import "go:context"
import "go:time"

import "domain"

struct FailingReader {}

impl FailingReader {
  fn list_clusters(
    self: FailingReader,
    _ctx: context.Context,
    _target: domain.TargetConfig,
  ) -> Result<Slice<domain.Cluster>, domain.Failure> {
    Err(unreachable())
  }

  fn find_cluster(
    self: FailingReader,
    _ctx: context.Context,
    _target: domain.TargetConfig,
    _name: string,
  ) -> Result<Option<domain.Cluster>, domain.Failure> {
    Err(unreachable())
  }
}

fn unreachable() -> domain.Failure {
  domain.fail(domain.ErrorKind.GeneralServiceException, "unreachable")
}

fn app_with_kiac_reader_failure() -> mut Application {
  new(
    FailingReader { .. },
    FakeLifecycle { .. },
    FakeNodePower { .. },
    FakeImageLoader { .. },
    FakeGpuCompat { .. },
    FakeVerifier { .. },
  )
}

#[test("a busy cluster past its convergence deadline times out")]
fn busy_cluster_past_deadline_times_out() {
  let mut app = app_with_clusters([busy_cluster()])
  app.ops.put(
    "dev",
    FakeHandle {
      state: domain.ProcessSnapshot {
        done: false,
        error: None,
        started_at: time.Now().Add(-time.Hour),
      },
      ..,
    },
  )
  let actual = app.check_status(context.Background(), target(), "dev", "")
  let StatusOutcome.Failure { failure } = actual else {
    assert false
    return
  }
  assert failure.kind == domain.ErrorKind.ServiceTimeout
}

#[test("a probe failure before the deadline remains in progress")]
fn probe_failure_before_deadline_remains_in_progress() {
  let mut app = app_with_kiac_reader_failure()
  let actual = app.check_status(context.Background(), target(), "dev", "")
  let StatusOutcome.InProgress { message, .. } = actual else {
    assert false
    return
  }
  assert message.contains("unreachable")
}

#[test("a probe failure after a failed create surfaces the create error")]
fn probe_failure_after_failed_create_is_failure() {
  let mut app = app_with_kiac_reader_failure()
  app.ops.put(
    "dev",
    FakeHandle {
      state: domain.ProcessSnapshot {
        done: true,
        error: Some("boom: cannot create"),
        ..,
      },
      ..,
    },
  )
  let actual = app.check_status(context.Background(), target(), "dev", "")
  let StatusOutcome.Failure { failure } = actual else {
    assert false
    return
  }
  assert failure.message.contains("boom")
}

#[test("a busy cluster with no handle times out from its creation time")]
fn busy_cluster_without_handle_times_out_from_created() {
  let mut cluster = busy_cluster()
  cluster.created = "2020-01-01T00:00:00Z"
  let mut app = app_with_clusters([cluster])
  let actual = app.check_status(context.Background(), target(), "dev", "")
  let StatusOutcome.Failure { failure } = actual else {
    assert false
    return
  }
  assert failure.kind == domain.ErrorKind.ServiceTimeout
}

#[test("a recent cluster with no handle stays in progress")]
fn recent_cluster_without_handle_stays_in_progress() {
  let mut cluster = busy_cluster()
  cluster.created = time.Now().Format(time.RFC3339)
  let mut app = app_with_clusters([cluster])
  let actual = app.check_status(context.Background(), target(), "dev", "")
  let StatusOutcome.InProgress { .. } = actual else {
    assert false
    return
  }
}

#[test("an unparseable creation time is not expired")]
fn unparseable_created_is_not_expired() {
  let mut cluster = busy_cluster()
  cluster.created = "not a timestamp"
  let mut app = app_with_clusters([cluster])
  let actual = app.check_status(context.Background(), target(), "dev", "")
  let StatusOutcome.InProgress { .. } = actual else {
    assert false
    return
  }
}

#[test("a fractional created time still expires")]
fn fractional_created_time_expires() {
  let mut cluster = busy_cluster()
  cluster.created = "2020-01-01T00:00:00.123456789Z"
  let mut app = app_with_clusters([cluster])
  let actual = app.check_status(context.Background(), target(), "dev", "")
  let StatusOutcome.Failure { failure } = actual else {
    assert false
    return
  }
  assert failure.kind == domain.ErrorKind.ServiceTimeout
}

#[test("an expired busy cluster says it did not converge")]
fn expired_cluster_message() {
  let mut app = app_with_clusters([busy_cluster()])
  app.ops.put(
    "dev",
    FakeHandle {
      state: domain.ProcessSnapshot {
        done: false,
        error: None,
        started_at: time.Now().Add(-time.Hour),
      },
      ..,
    },
  )
  let actual = app.check_status(context.Background(), target(), "dev", "")
  let StatusOutcome.Failure { failure } = actual else {
    assert false
    return
  }
  assert failure.message == "cluster dev did not converge"
}
