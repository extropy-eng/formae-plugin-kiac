import "go:context"

import "domain"

fn split_node(spec: domain.NodeSpec) -> (string, string) {
  if !spec.cluster_name.is_empty() && !spec.name.is_empty() {
    (spec.cluster_name, spec.name)
  } else {
    domain.split_id(spec.id)
  }
}

impl Application {
  pub fn list_nodes(
    self: mut Ref<Application>,
    ctx: context.Context,
    target: domain.TargetConfig,
    cluster: string,
  ) -> Result<Slice<string>, domain.Failure> {
    if cluster.is_empty() { return Ok([]) }
    match self.reader.find_cluster(ctx, target, cluster)? {
      Some(parent) => Ok(parent.nodes.map(|node| f"{cluster}/{node.name}")),
      None => Ok([]),
    }
  }

  pub fn delete_node(
    self: Ref<Application>,
    native_id: string,
  ) -> Result<DeleteOutcome, domain.Failure> {
    Ok(DeleteOutcome { native_id, no_op: true })
  }

  pub fn update_node(
    self: mut Ref<Application>,
    ctx: context.Context,
    target: domain.TargetConfig,
    native_id: string,
    prior: domain.NodeSpec,
    desired: domain.NodeSpec,
  ) -> Result<UpdateOutcome, domain.Failure> {
    let (cluster_name, node_name) = if !desired.cluster_name.is_empty() && !desired.name.is_empty() {
      (desired.cluster_name, desired.name)
    } else {
      domain.split_id(native_id)
    }
    let resolved_id = if native_id.is_empty() {
      f"{cluster_name}/{node_name}"
    } else {
      native_id
    }
    if desired.state.is_empty() || desired.state == prior.state {
      return Ok(
        UpdateOutcome {
          native_id: resolved_id,
          properties: ResourceProperties.None,
        },
      )
    }
    let power = match domain.node_power_for(desired.state) {
      Some(power) => power,
      None => {
        return Err(domain.fail(
          domain.ErrorKind.InvalidRequest,
          "state must be running or stopped",
        ))
      },
    }
    self.node_power.set_node_power(ctx, target, cluster_name, node_name, power)?
    let properties = self.reader.find_cluster(ctx, target, cluster_name)?.map_or(
      ResourceProperties.None,
      |parent| {
        parent.nodes
          .find(|node| node.name == node_name)
          .map_or(ResourceProperties.None, |node| {
            ResourceProperties.Node { cluster: cluster_name, node }
          })
      },
    )
    Ok(UpdateOutcome { native_id: resolved_id, properties })
  }

  pub fn read_node(
    self: mut Ref<Application>,
    ctx: context.Context,
    target: domain.TargetConfig,
    native_id: string,
  ) -> Result<ResourceProperties, domain.Failure> {
    let (cluster_name, node_name) = domain.split_id(native_id)
    let parent = match self.reader.find_cluster(ctx, target, cluster_name)? {
      Some(parent) => parent,
      None => {
        return Err(domain.fail(
          domain.ErrorKind.NotFound,
          f"cluster not found: {cluster_name}",
        ))
      },
    }
    match parent.nodes.find(|node| node.name == node_name) {
      Some(node) => Ok(ResourceProperties.Node { cluster: cluster_name, node }),
      None => Err(domain.fail(
        domain.ErrorKind.NotFound,
        f"node not found: {cluster_name}/{node_name}",
      )),
    }
  }

  pub fn create_node(
    self: mut Ref<Application>,
    ctx: context.Context,
    target: domain.TargetConfig,
    spec: domain.NodeSpec,
  ) -> Result<CreateOutcome, domain.Failure> {
    let (cluster_name, node_name) = split_node(spec)
    let parent = match self.reader.find_cluster(ctx, target, cluster_name)? {
      Some(parent) => parent,
      None => {
        return Err(domain.fail(
          domain.ErrorKind.DependencyFailure,
          f"parent cluster not found: {cluster_name}",
        ))
      },
    }
    let node = match parent.nodes.find(|node| node.name == node_name) {
      Some(node) => node,
      None => {
        return Err(domain.fail(
          domain.ErrorKind.NotFound,
          f"node not found: {cluster_name}/{node_name}",
        ))
      },
    }
    let native_id = if spec.id.is_empty() {
      f"{cluster_name}/{node_name}"
    } else {
      spec.id
    }
    Ok(
      CreateOutcome {
        native_id,
        request_id: native_id,
        status: CreateStatus.Success,
        message: "",
        properties: ResourceProperties.Node { cluster: cluster_name, node },
      },
    )
  }
}
