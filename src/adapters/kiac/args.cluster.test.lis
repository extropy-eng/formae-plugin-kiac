import "domain"

#[test("k3s clusters omit the cni flag")]
fn k3s_clusters_omit_cni() {
  let actual = cluster_create_args(
    domain.ClusterSpec {
      name: "dev",
      distro: "k3s",
      cni: "cilium",
      workers: 2,
      ..,
    },
  )
  let expected = [
    "create",
    "cluster",
    "--name",
    "dev",
    "--distro",
    "k3s",
    "--workers",
    "2",
  ]
  assert actual.equals(expected)
}

#[test("cluster arguments pass an explicit cpu count")]
fn cluster_argv_passes_cpus() {
  let actual = cluster_create_args(
    domain.ClusterSpec { name: "dev", cpus: "2", .. },
  )
  let expected = ["create", "cluster", "--name", "dev", "--cpus", "2"]
  assert actual.equals(expected)
}

#[test("cluster arguments includes GPU, boolean, mount, and publish flags")]
fn cluster_argv_includes_all_optional_flags() {
  let actual = cluster_create_args(
    domain.ClusterSpec {
      name: "dev",
      distro: "kubeadm",
      cni: "cilium",
      gpu_workers: 2,
      gpu_image: "gpu:latest",
      gateway: true,
      no_lb: true,
      dns: ["1.1.1.1"],
      mounts: [
        domain.MountSpec { source: "/a", target: "/b", readonly: true, .. },
      ],
      publish: [
        domain.PortMappingSpec {
          host_ip: "127.0.0.1",
          host_port: 8080,
          container_port: 80,
          protocol: "tcp",
        },
      ],
      ..,
    },
  )
  let expected = [
    "create",
    "cluster",
    "--name",
    "dev",
    "--distro",
    "kubeadm",
    "--cni",
    "cilium",
    "--gpu-workers",
    "2",
    "--gpu-image",
    "gpu:latest",
    "--gateway",
    "--no-lb",
    "--dns",
    "1.1.1.1",
    "--mount",
    "type=bind,source=/a,target=/b,readonly",
    "-p",
    "127.0.0.1:8080:80/tcp",
  ]
  assert actual.equals(expected)
}

#[test("cluster argv passes every supported create flag")]
fn cluster_argv_passes_every_create_flag() {
  let actual = cluster_create_args(
    domain.ClusterSpec {
      name: "dev",
      distro: "kubeadm",
      cni: "cilium",
      cpus: "2",
      memory: "8G",
      cp_memory: "4G",
      k8s_version: "v1.30.0",
      image: "node:latest",
      kernel: "full",
      ip_family: "dual",
      observability: true,
      gpu_workers: 1,
      gpu_image: "gpu:latest",
      gpu_disk_size: "30G",
      gpu_resource_driver: "dra",
      no_edge_proxy: true,
      no_lb: true,
      no_metrics: true,
      no_storage: true,
      wait: "10m",
      ..,
    },
  )
  let expected = [
    "create",
    "cluster",
    "--name",
    "dev",
    "--distro",
    "kubeadm",
    "--cni",
    "cilium",
    "--cpus",
    "2",
    "--memory",
    "8G",
    "--cp-memory",
    "4G",
    "--k8s-version",
    "v1.30.0",
    "--image",
    "node:latest",
    "--kernel",
    "full",
    "--ip-family",
    "dual",
    "--observability",
    "--gpu-workers",
    "1",
    "--gpu-image",
    "gpu:latest",
    "--gpu-disk-size",
    "30G",
    "--gpu-resource-driver",
    "dra",
    "--no-edge-proxy",
    "--no-lb",
    "--no-metrics",
    "--no-storage",
    "--wait",
    "10m",
  ]
  assert actual.equals(expected)
}
