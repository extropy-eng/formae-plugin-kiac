import "go:context"
import "go:encoding/json"
import "go:os"
import "go:path/filepath"
import "go:strings"
import "go:time"

import "domain"
import "ports"

#[test("stderr containing already exists maps to AlreadyExists")]
fn already_exists_stderr_maps_to_already_exists() {
  assert classify_error("cluster already exists") ==
  domain.ErrorKind.AlreadyExists
}

#[test("stderr containing no such maps to NotFound")]
fn missing_cluster_stderr_maps_to_not_found() {
  assert classify_error("no such cluster") == domain.ErrorKind.NotFound
}

#[test("stderr containing timeout maps to ServiceTimeout")]
fn timeout_stderr_maps_to_service_timeout() {
  assert classify_error("timed out waiting") == domain.ErrorKind.ServiceTimeout
}

#[test("stderr containing permission denied maps to AccessDenied")]
fn permission_stderr_maps_to_access_denied() {
  assert classify_error("permission denied") == domain.ErrorKind.AccessDenied
}

#[test("unrecognized stderr maps to GeneralServiceException")]
fn unknown_stderr_maps_to_general_service_exception() {
  assert classify_error("unexpected") ==
  domain.ErrorKind.GeneralServiceException
}

/// Write an executable fake `kiac` and return its absolute path.
fn fake_kiac(body: string) -> Result<string, error> {
  let dir = os.MkdirTemp("", "kiac-test")?
  let path = filepath.Join(dir, "kiac")
  os.WriteFile(path, (f"#!/bin/sh\n{body}") as Slice<byte>, 0o755)?
  Ok(path)
}

fn expect_failure<T>(result: Result<T, domain.Failure>) -> domain.Failure {
  match result {
    Err(failure) => failure,
    Ok(_) => domain.fail(domain.ErrorKind.InternalFailure, "expected failure"),
  }
}

fn target_with_fake_kiac(body: string) -> Result<domain.TargetConfig, error> {
  Ok(domain.TargetConfig { kiac_path: fake_kiac(body)?, .. })
}

fn temp_file(name: string) -> Result<string, error> {
  let dir = os.MkdirTemp("", "kiac-test")?
  Ok(filepath.Join(dir, name))
}

fn read_text(path: string) -> Result<string, error> {
  Ok((os.ReadFile(path)?) as string)
}

fn wait_for_file_contains(path: string, needle: string) -> string {
  for _i in 0..200 {
    let text = read_text(path).unwrap_or("")
    if text.contains(needle) { return text }
    time.Sleep(10 * time.Millisecond)
  }
  ""
}

fn wait_for_handle(
  handle: ports.OperationHandle,
) -> Result<domain.ProcessSnapshot, error> {
  for _i in 0..200 {
    let snapshot = handle.snapshot()
    if snapshot.done { return Ok(snapshot) }
    time.Sleep(10 * time.Millisecond)
  }
  Err(domain.fail(domain.ErrorKind.InternalFailure, "handle did not finish"))
}

#[test("the runner returns captured stdout")]
fn runner_returns_captured_stdout() -> Result<(), error> {
  let target = domain.TargetConfig { kiac_path: fake_kiac("echo 'hello'")?, .. }
  let actual = run_kiac(context.Background(), target, [])?
  assert actual == ProcResult { stdout: "hello\n" }
  Ok(())
}

#[test("a failing runner returns the classified stderr failure")]
fn runner_returns_classified_stderr() -> Result<(), error> {
  let target = domain.TargetConfig {
    kiac_path: fake_kiac("echo 'cluster not found' >&2; exit 1")?,
    ..,
  }
  let failure = expect_failure(run_kiac(context.Background(), target, []))
  assert failure ==
  domain.Failure {
    kind: domain.ErrorKind.NotFound,
    message: "cluster not found",
  }
  Ok(())
}

#[test("kiac cluster JSON maps to the domain cluster")]
fn kiac_cluster_maps_to_domain_cluster() -> Result<(), error> {
  let raw = "{
    \"name\": \"dev\",
    \"status\": \"1/1 running\",
    \"runningNodes\": 1,
    \"totalNodes\": 1,
    \"k8sVersion\": \"v1.37.0-k3s1\",
    \"created\": \"2026-10-04T03:18:35Z\",
    \"nodes\": [
      {
        \"name\": \"cp\",
        \"state\": \"running\",
        \"ip\": \"10.0.0.1\",
        \"image\": \"img\",
        \"created\": \"2026-10-04T03:18:35Z\"
      }
    ]
  }"
  let mut actual: KiacCluster = KiacCluster { .. }
  json.Unmarshal(raw as Slice<byte>, &actual)?
  let expected = domain.Cluster {
    name: "dev",
    status: "1/1 running",
    running_nodes: 1,
    total_nodes: 1,
    k8s_version: "v1.37.0-k3s1",
    created: "2026-10-04T03:18:35Z",
    nodes: [
      domain.Node {
        name: "cp",
        state: "running",
        ip: "10.0.0.1",
        image: "img",
        created: "2026-10-04T03:18:35Z",
      },
    ],
  }
  assert actual.to_domain().equals(expected)
  Ok(())
}

#[test("listing clusters maps kiac JSON to domain values")]
fn listing_clusters_maps_to_domain_values() -> Result<(), error> {
  let raw = "[
    {
      \"name\": \"dev\",
      \"nodes\": []
    }
  ]"
  let actual = list_clusters(
    context.Background(),
    target_with_fake_kiac(f"echo '{raw}'")?,
  )?
  let expected = [domain.Cluster { name: "dev", .. }]
  assert actual.equals(expected)
  Ok(())
}

#[test("an empty cluster response is an empty slice")]
fn empty_cluster_response_is_empty() -> Result<(), error> {
  let actual = list_clusters(
    context.Background(),
    target_with_fake_kiac("printf '[]'")?,
  )?
  assert actual.is_empty()
  Ok(())
}

#[test("finding a cluster by name returns the matching cluster")]
fn find_cluster_returns_matching_cluster() -> Result<(), error> {
  let raw = "[
    {
      \"name\": \"dev\",
      \"nodes\": []
    }
  ]"
  let found = find_cluster(
    context.Background(),
    target_with_fake_kiac(f"echo '{raw}'")?,
    "dev",
  )?
  let Some(cluster) = found else {
    assert false
    return Ok(())
  }
  assert cluster.name == "dev"
  Ok(())
}

#[test("finding a missing cluster returns none")]
fn find_missing_cluster_returns_none() -> Result<(), error> {
  let found = find_cluster(
    context.Background(),
    target_with_fake_kiac("printf '[]'")?,
    "missing",
  )?
  assert found.is_none()
  Ok(())
}

#[test("k3s clusters omit the cni flag")]
fn k3s_clusters_omit_cni() {
  let actual = cluster_create_args(
    domain.ClusterSpec {
      name: "dev",
      distro: "k3s",
      cni: "cilium",
      workers: 2,
      ..,
    },
  )
  let expected = [
    "create",
    "cluster",
    "--name",
    "dev",
    "--distro",
    "k3s",
    "--workers",
    "2",
  ]
  assert actual.equals(expected)
}

#[test("a cluster create runs the expected command in the background")]
fn cluster_create_runs_in_background() -> Result<(), error> {
  let log_file = temp_file("args")?
  let target = target_with_fake_kiac(
    f"printf '%s\\n' \"$*\" >> {log_file}; sleep 0.1",
  )?
  let handle = KiacCli { .. }.start_create_cluster(
    target,
    domain.ClusterSpec { name: "dev", .. },
  )
  let seen = wait_for_file_contains(log_file, "create cluster --name dev")
  assert strings.TrimSpace(seen) == "create cluster --name dev"
  let snapshot = wait_for_handle(handle)?
  assert snapshot.done
  assert snapshot.error.is_none()
  Ok(())
}

#[test("a failed cluster create start is reported by the snapshot")]
fn failed_cluster_create_start_is_reported() {
  let target = domain.TargetConfig { kiac_path: "/does/not/exist/kiac", .. }
  let handle = KiacCli { .. }.start_create_cluster(
    target,
    domain.ClusterSpec { name: "dev", .. },
  )
  let snapshot = handle.snapshot()
  assert snapshot.done
  assert snapshot.error.is_some()
}

#[test("a cluster resume runs the expected command in the background")]
fn cluster_resume_runs_in_background() -> Result<(), error> {
  let log_file = temp_file("args")?
  let target = target_with_fake_kiac(
    f"printf '%s\\n' \"$*\" >> {log_file}; sleep 0.1",
  )?
  let handle = KiacCli { .. }.start_resume_cluster(target, "dev")
  let seen = wait_for_file_contains(log_file, "resume cluster --name dev")
  assert strings.TrimSpace(seen) == "resume cluster --name dev"
  let snapshot = wait_for_handle(handle)?
  assert snapshot.done
  Ok(())
}

#[test("deleting a cluster runs the delete command")]
fn deleting_cluster_runs_delete() -> Result<(), error> {
  let log_file = temp_file("args")?
  let target = target_with_fake_kiac(f"printf '%s\\n' \"$*\" >> {log_file}")?
  KiacCli { .. }.delete_cluster(context.Background(), target, "dev")?
  let seen = read_text(log_file)?
  assert strings.TrimSpace(seen) == "delete cluster --name dev"
  Ok(())
}

#[test("cluster argv includes GPU, boolean, mount, and publish flags")]
fn cluster_argv_includes_all_optional_flags() {
  let actual = cluster_create_args(
    domain.ClusterSpec {
      name: "dev",
      distro: "kubeadm",
      cni: "cilium",
      gpu_workers: 2,
      gpu_image: "gpu:latest",
      gateway: true,
      no_lb: true,
      dns: ["1.1.1.1"],
      mounts: [
        domain.MountSpec { source: "/a", target: "/b", readonly: true, .. },
      ],
      publish: [
        domain.PortMappingSpec {
          host_ip: "127.0.0.1",
          host_port: 8080,
          container_port: 80,
          protocol: "tcp",
        },
      ],
      ..,
    },
  )
  let expected = [
    "create",
    "cluster",
    "--name",
    "dev",
    "--distro",
    "kubeadm",
    "--cni",
    "cilium",
    "--gpu-workers",
    "2",
    "--gpu-image",
    "gpu:latest",
    "--gateway",
    "--no-lb",
    "--dns",
    "1.1.1.1",
    "--mount",
    "type=bind,source=/a,target=/b,readonly",
    "-p",
    "127.0.0.1:8080:80/tcp",
  ]
  assert actual.equals(expected)
}
