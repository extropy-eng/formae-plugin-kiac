import "go:context"
import "go:strings"

import "domain"
import "ports"

#[test("finding a cluster by name returns the matching cluster")]
fn find_cluster_returns_matching_cluster() -> Result<(), error> {
  let raw = "[
    {
      \"name\": \"dev\",
      \"nodes\": []
    }
  ]"
  let found = find_cluster(
    context.Background(),
    target_with_fake_kiac(f"echo '{raw}'")?,
    "dev",
  )?
  let Some(cluster) = found else {
    assert false
    return Ok(())
  }
  assert cluster.name == "dev"
  Ok(())
}

#[test("finding a missing cluster returns none")]
fn find_missing_cluster_returns_none() -> Result<(), error> {
  let found = find_cluster(
    context.Background(),
    target_with_fake_kiac("printf '[]'")?,
    "missing",
  )?
  assert found.is_none()
  Ok(())
}

#[test("a cluster create runs the expected command in the background")]
fn cluster_create_runs_in_background() -> Result<(), error> {
  let log_file = temp_file("args")?
  let target = target_with_fake_kiac(
    f"printf '%s\\n' \"$*\" >> {log_file}; sleep 0.1",
  )?
  let handle = KiacCli { .. }.start_create_cluster(
    target,
    domain.ClusterSpec { name: "dev", .. },
  )
  let seen = wait_for_file_contains(log_file, "create cluster --name dev")
  assert strings.TrimSpace(seen) == "create cluster --name dev"
  let snapshot = wait_for_handle(handle)?
  assert snapshot.done
  assert snapshot.error.is_none()
  Ok(())
}

#[test("a failed cluster create start is reported by the snapshot")]
fn failed_cluster_create_start_is_reported() {
  let target = domain.TargetConfig { kiac_path: "/does/not/exist/kiac", .. }
  let handle = KiacCli { .. }.start_create_cluster(
    target,
    domain.ClusterSpec { name: "dev", .. },
  )
  let snapshot = handle.snapshot()
  assert snapshot.done
  assert snapshot.error.is_some()
}

#[test("a cluster resume runs the expected command in the background")]
fn cluster_resume_runs_in_background() -> Result<(), error> {
  let log_file = temp_file("args")?
  let target = target_with_fake_kiac(
    f"printf '%s\\n' \"$*\" >> {log_file}; sleep 0.1",
  )?
  let handle = KiacCli { .. }.start_resume_cluster(target, "dev")
  let seen = wait_for_file_contains(log_file, "resume cluster --name dev")
  assert strings.TrimSpace(seen) == "resume cluster --name dev"
  let snapshot = wait_for_handle(handle)?
  assert snapshot.done
  Ok(())
}

#[test("deleting a cluster runs the delete command")]
fn deleting_cluster_runs_delete() -> Result<(), error> {
  let log_file = temp_file("args")?
  let target = target_with_fake_kiac(f"printf '%s\\n' \"$*\" >> {log_file}")?
  KiacCli { .. }.delete_cluster(context.Background(), target, "dev")?
  let seen = read_text(log_file)?
  assert strings.TrimSpace(seen) == "delete cluster --name dev"
  Ok(())
}

#[test("running a node uses the start verb")]
fn running_node_uses_start_verb() -> Result<(), error> {
  let log_file = temp_file("args")?
  let target = target_with_fake_kiac(f"printf '%s\\n' \"$*\" >> {log_file}")?
  KiacCli { .. }.set_node_power(
    context.Background(),
    target,
    "dev",
    "cp",
    domain.NodePower.Running,
  )?
  let seen = read_text(log_file)?
  assert strings.TrimSpace(seen) == "start node cp --name dev"
  Ok(())
}

#[test("stopping a node uses the stop verb")]
fn stopping_node_uses_stop_verb() -> Result<(), error> {
  let log_file = temp_file("args")?
  let target = target_with_fake_kiac(f"printf '%s\\n' \"$*\" >> {log_file}")?
  KiacCli { .. }.set_node_power(
    context.Background(),
    target,
    "dev",
    "cp",
    domain.NodePower.Stopped,
  )?
  let seen = read_text(log_file)?
  assert strings.TrimSpace(seen) == "stop node cp --name dev"
  Ok(())
}

#[test("loading an image runs the image load command")]
fn loading_image_runs_load() -> Result<(), error> {
  let log_file = temp_file("args")?
  let target = target_with_fake_kiac(f"printf '%s\\n' \"$*\" >> {log_file}")?
  KiacCli { .. }.load_image(context.Background(), target, "dev", "myapp:latest")?
  let seen = read_text(log_file)?
  assert strings.TrimSpace(seen) == "load image myapp:latest --name dev"
  Ok(())
}

#[test("cluster verification JSON maps to the domain verification")]
fn verification_maps_to_domain() -> Result<(), error> {
  let payload = "{
    \"healthy\": true,
    \"checkedAt\": \"2026-10-04T20:01:06Z\",
    \"duration\": \"2s\",
    \"checks\": [
      {
        \"id\": \"kubernetes.api\",
        \"name\": \"Kubernetes API\",
        \"status\": \"pass\",
        \"detail\": \"ok\"
      }
    ]
  }"
  let target = target_with_fake_kiac(f"echo '{payload}'")?
  let actual = KiacCli { .. }.verify_cluster(
    context.Background(),
    target,
    "dev",
  )?
  let expected = domain.Verification {
    cluster_name: "dev",
    healthy: true,
    checked_at: "2026-10-04T20:01:06Z",
    duration: "2s",
    checks: [
      domain.Check {
        id: "kubernetes.api",
        name: "Kubernetes API",
        status: "pass",
        detail: "ok",
      },
    ],
  }
  assert actual.equals(expected)
  Ok(())
}
