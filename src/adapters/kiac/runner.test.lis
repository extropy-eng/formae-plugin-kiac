import "go:context"

import "domain"

#[test("the runner returns captured stdout")]
fn runner_returns_captured_stdout() -> Result<(), error> {
  let target = domain.TargetConfig { kiac_path: fake_kiac("echo 'hello'")?, .. }
  let actual = run_kiac(context.Background(), target, [])?
  assert actual == ProcResult { stdout: "hello\n" }
  Ok(())
}

#[test("a failing runner returns the classified stderr failure")]
fn runner_returns_classified_stderr() -> Result<(), error> {
  let target = domain.TargetConfig {
    kiac_path: fake_kiac("echo 'cluster not found' >&2; exit 1")?,
    ..,
  }
  let failure = expect_failure(run_kiac(context.Background(), target, []))
  assert failure ==
  domain.Failure {
    kind: domain.ErrorKind.NotFound,
    message: "cluster not found",
  }
  Ok(())
}
