import "go:context"
import "go:encoding/json"
import "go:strings"

import "domain"
import "ports"

pub struct KiacCli {}

impl KiacCli {
  pub fn start_create_cluster(
    self: KiacCli,
    target: domain.TargetConfig,
    spec: domain.ClusterSpec,
  ) -> ports.OperationHandle {
    start_process(target, cluster_create_args(spec))
  }

  pub fn start_resume_cluster(
    self: KiacCli,
    target: domain.TargetConfig,
    cluster: string,
  ) -> ports.OperationHandle {
    start_process(target, ["resume", "cluster", "--name", cluster])
  }

  pub fn delete_cluster(
    self: KiacCli,
    ctx: context.Context,
    target: domain.TargetConfig,
    name: string,
  ) -> Result<(), domain.Failure> {
    run_kiac(ctx, target, ["delete", "cluster", "--name", name]).map(|_| ())
  }

  pub fn set_node_power(
    self: KiacCli,
    ctx: context.Context,
    target: domain.TargetConfig,
    cluster: string,
    node: string,
    power: domain.NodePower,
  ) -> Result<(), domain.Failure> {
    run_kiac(ctx, target, [
        node_power_verb(power),
        "node",
        node,
        "--name",
        cluster,
      ]).map(
      |_| (),
    )
  }

  pub fn load_image(
    self: KiacCli,
    ctx: context.Context,
    target: domain.TargetConfig,
    cluster: string,
    image: string,
  ) -> Result<(), domain.Failure> {
    run_kiac(ctx, target, ["load", "image", image, "--name", cluster]).map(
      |_| (),
    )
  }

  pub fn set_gpu_compat(
    self: KiacCli,
    ctx: context.Context,
    target: domain.TargetConfig,
    cluster: string,
    namespace: string,
    enabled: bool,
    rotate: bool,
  ) -> Result<(), domain.Failure> {
    let verb = if enabled { "enable" } else { "disable" }
    run_kiac(ctx, target, gpu_compat_args(verb, cluster, namespace, rotate)).map(
      |_| (),
    )
  }

  pub fn verify_cluster(
    self: KiacCli,
    ctx: context.Context,
    target: domain.TargetConfig,
    cluster: string,
  ) -> Result<domain.Verification, domain.Failure> {
    let result = run_kiac(ctx, target, [
      "verify",
      "cluster",
      "--name",
      cluster,
      "-o",
      "json",
    ])?
    let mut raw: VerificationRaw = VerificationRaw { .. }
    json
      .Unmarshal(result.stdout as Slice<byte>, &raw)
      .map_err(|_| {
        domain.fail(domain.ErrorKind.InternalFailure, "invalid verify output")
      })?
    Ok(raw.to_domain(cluster))
  }
}

fn fetch_clusters(
  ctx: context.Context,
  target: domain.TargetConfig,
) -> Result<Slice<KiacCluster>, domain.Failure> {
  let result = run_kiac(ctx, target, ["get", "clusters", "-o", "json"])?
  let output = strings.TrimSpace(result.stdout)
  if output == "" || output == "null" {
    Ok([])
  } else {
    let mut clusters: Slice<KiacCluster> = []
    json
      .Unmarshal(output as Slice<byte>, &clusters)
      .map_err(|e| {
        domain.fail(
          domain.ErrorKind.GeneralServiceException,
          f"parse kiac clusters: {e.Error()}",
        )
      })?
    Ok(clusters)
  }
}

pub fn list_clusters(
  ctx: context.Context,
  target: domain.TargetConfig,
) -> Result<Slice<domain.Cluster>, domain.Failure> {
  fetch_clusters(ctx, target).map(|clusters| clusters.map(
    |cluster| cluster.to_domain(),
  ))
}

pub fn find_cluster(
  ctx: context.Context,
  target: domain.TargetConfig,
  name: string,
) -> Result<Option<domain.Cluster>, domain.Failure> {
  fetch_clusters(ctx, target).map(|clusters| clusters
    .find(|c| c.name == name)
    .map(|c| c.to_domain()))
}
