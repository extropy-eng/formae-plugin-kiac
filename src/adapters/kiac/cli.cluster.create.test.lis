import "go:strings"

import "domain"

#[test("a cluster create runs the expected command in the background")]
fn cluster_create_runs_in_background() -> Result<(), error> {
  let log_file = temp_file("args")?
  let target = target_with_fake_kiac(
    f"printf '%s\\n' \"$*\" >> {log_file}; sleep 0.1",
  )?
  let handle = KiacCli { .. }.start_create_cluster(
    target,
    domain.ClusterSpec { name: "dev", .. },
  )
  let seen = wait_for_file_contains(log_file, "create cluster --name dev")
  assert strings.TrimSpace(seen) == "create cluster --name dev"
  let snapshot = wait_for_handle(handle)?
  assert snapshot.done
  assert snapshot.error.is_none()
  Ok(())
}

#[test("a failed cluster create start is reported by the snapshot")]
fn failed_cluster_create_start_is_reported() {
  let target = domain.TargetConfig { kiac_path: "/does/not/exist/kiac", .. }
  let handle = KiacCli { .. }.start_create_cluster(
    target,
    domain.ClusterSpec { name: "dev", .. },
  )
  let snapshot = handle.snapshot()
  assert snapshot.done
  assert snapshot.error.is_some()
}
