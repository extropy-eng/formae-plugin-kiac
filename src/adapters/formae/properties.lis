import "go:encoding/json"

import "application"
import "domain"

#[json(camel_case)]
#[equality]
pub struct NodeOutput {
  pub id: string,
  pub cluster_name: string,
  pub name: string,
  pub state: string,
  pub ip: string,
  pub image: string,
  pub created: string,
}

#[json(camel_case)]
#[equality]
pub struct ClusterOutput {
  pub name: string,
  pub status: string,
  pub running_nodes: int,
  pub total_nodes: int,
  pub installed_k8s_version: string,
  pub created: string,
  pub nodes: Slice<NodeOutput>,
}

#[json(camel_case)]
pub struct GpuCompatOutput {
  pub id: string,
  pub cluster_name: string,
  pub namespace: string,
  pub enabled: bool,
  pub rotate_certificate: bool,
}

#[json(camel_case)]
pub struct GpuCompatStateOutput {
  pub id: string,
  pub cluster_name: string,
  pub namespace: string,
}

#[json(camel_case)]
pub struct ImageOutput {
  pub id: string,
  pub cluster_name: string,
  pub image: string,
}

#[json(camel_case)]
pub struct CheckOutput {
  pub id: string,
  pub name: string,
  pub status: string,
  pub detail: string,
}

#[json(camel_case)]
pub struct VerificationOutput {
  pub cluster_name: string,
  pub healthy: bool,
  pub checked_at: string,
  pub duration: string,
  pub checks: Slice<CheckOutput>,
}

#[json(camel_case)]
pub struct ResumeOutput {
  pub id: string,
  pub cluster_name: string,
  pub nonce: string,
}

fn encode<T>(value: T) -> string {
  json.Marshal(value).map_or("", |text| text as string)
}

fn node_output(cluster: string, node: domain.Node) -> NodeOutput {
  NodeOutput {
    id: f"{cluster}/{node.name}",
    cluster_name: cluster,
    name: node.name,
    state: node.state,
    ip: node.ip,
    image: node.image,
    created: node.created,
  }
}

pub fn encode_properties(props: application.ResourceProperties) -> string {
  match props {
    application.ResourceProperties.None => "",
    application.ResourceProperties.Cluster(cluster) => encode(
      ClusterOutput {
        name: cluster.name,
        status: cluster.status,
        running_nodes: cluster.running_nodes,
        total_nodes: cluster.total_nodes,
        installed_k8s_version: cluster.k8s_version,
        created: cluster.created,
        nodes: cluster.nodes.map(|node| node_output(cluster.name, node)),
      },
    ),
    application.ResourceProperties.Node { cluster, node } => encode(node_output(
      cluster,
      node,
    )),
    application.ResourceProperties.GpuCompat(gpu) => encode(
      GpuCompatOutput {
        id: gpu.id,
        cluster_name: gpu.cluster_name,
        namespace: gpu.namespace,
        enabled: gpu.enabled,
        rotate_certificate: false,
      },
    ),
    application.ResourceProperties.GpuCompatState(state) => encode(
      GpuCompatStateOutput {
        id: state.id,
        cluster_name: state.cluster_name,
        namespace: state.namespace,
      },
    ),
    application.ResourceProperties.Image(image) => encode(
      ImageOutput {
        id: image.id,
        cluster_name: image.cluster_name,
        image: image.image,
      },
    ),
    application.ResourceProperties.Verification(verification) => encode(
      VerificationOutput {
        cluster_name: verification.cluster_name,
        healthy: verification.healthy,
        checked_at: verification.checked_at,
        duration: verification.duration,
        checks: verification.checks.map(|check| CheckOutput {
          id: check.id,
          name: check.name,
          status: check.status,
          detail: check.detail,
        }),
      },
    ),
    application.ResourceProperties.Resume(resume) => encode(
      ResumeOutput {
        id: resume.id,
        cluster_name: resume.cluster_name,
        nonce: resume.nonce,
      },
    ),
  }
}

#[json(camel_case)]
struct MountPropsRaw { source: string, target: string, readonly: bool }

#[json(camel_case)]
struct PortMappingPropsRaw {
  host_ip: string,
  host_port: int,
  container_port: int,
  protocol: string,
}

#[json(camel_case)]
struct ClusterPropsRaw {
  name: string,
  distro: string,
  cni: string,
  workers: int,
  gpu_workers: int,
  gpu_image: string,
  gateway: bool,
  no_lb: bool,
  dns: Slice<string>,
  mounts: Slice<MountPropsRaw>,
  publish: Slice<PortMappingPropsRaw>,
}

#[json(camel_case)]
struct NodePropsRaw {
  id: string,
  cluster_name: string,
  name: string,
  state: string,
}

#[json(camel_case)]
struct GpuCompatPropsRaw {
  id: string,
  cluster_name: string,
  namespace: string,
  enabled: bool,
  rotate_certificate: bool,
}

#[json(camel_case)]
struct ImagePropsRaw { id: string, cluster_name: string, image: string }

#[json(camel_case)]
struct VerificationPropsRaw { cluster_name: string }

#[json(camel_case)]
struct ResumePropsRaw { id: string, cluster_name: string, nonce: string }

fn invalid(error: string) -> domain.Failure {
  domain.fail(domain.ErrorKind.InvalidRequest, f"invalid properties: {error}")
}

pub fn decode_cluster_props(
  raw: json.RawMessage,
) -> Result<domain.ClusterSpec, domain.Failure> {
  let mut parsed = ClusterPropsRaw { .. }
  json.Unmarshal(raw.0, &parsed).map_err(|e| invalid(e.Error()))?
  Ok(
    domain.ClusterSpec {
      name: parsed.name,
      distro: parsed.distro,
      cni: parsed.cni,
      workers: parsed.workers,
      gpu_workers: parsed.gpu_workers,
      gpu_image: parsed.gpu_image,
      gateway: parsed.gateway,
      no_lb: parsed.no_lb,
      dns: parsed.dns,
      mounts: parsed.mounts.map(|mount| domain.MountSpec {
        source: mount.source,
        target: mount.target,
        readonly: mount.readonly,
      }),
      publish: parsed.publish.map(|mapping| domain.PortMappingSpec {
        host_ip: mapping.host_ip,
        host_port: mapping.host_port,
        container_port: mapping.container_port,
        protocol: mapping.protocol,
      }),
    },
  )
}

pub fn decode_node_props(
  raw: json.RawMessage,
) -> Result<domain.NodeSpec, domain.Failure> {
  let mut parsed = NodePropsRaw { .. }
  json.Unmarshal(raw.0, &parsed).map_err(|e| invalid(e.Error()))?
  Ok(
    domain.NodeSpec {
      id: parsed.id,
      cluster_name: parsed.cluster_name,
      name: parsed.name,
      state: parsed.state,
    },
  )
}

pub fn decode_prior_node(raw: json.RawMessage) -> domain.NodeSpec {
  let mut parsed = NodePropsRaw { .. }
  let _ = json.Unmarshal(raw.0, &parsed)
  domain.NodeSpec {
    id: parsed.id,
    cluster_name: parsed.cluster_name,
    name: parsed.name,
    state: parsed.state,
  }
}

pub fn decode_gpu_compat(
  raw: json.RawMessage,
) -> Result<domain.GpuCompatSpec, domain.Failure> {
  let mut parsed = GpuCompatPropsRaw { .. }
  json
    .Unmarshal(raw.0, &parsed)
    .map_err(|e| domain.fail(domain.ErrorKind.InvalidRequest, e.Error()))?
  Ok(
    domain.GpuCompatSpec {
      id: parsed.id,
      cluster_name: parsed.cluster_name,
      namespace: parsed.namespace,
      enabled: parsed.enabled,
      rotate_certificate: parsed.rotate_certificate,
    },
  )
}

pub fn decode_desired_gpu_compat(raw: json.RawMessage) -> domain.GpuCompatSpec {
  let mut parsed = GpuCompatPropsRaw { .. }
  let _ = json.Unmarshal(raw.0, &parsed)
  domain.GpuCompatSpec {
    id: parsed.id,
    cluster_name: parsed.cluster_name,
    namespace: parsed.namespace,
    enabled: parsed.enabled,
    rotate_certificate: parsed.rotate_certificate,
  }
}

pub fn decode_image(
  raw: json.RawMessage,
) -> Result<domain.ImageSpec, domain.Failure> {
  let mut parsed = ImagePropsRaw { .. }
  json
    .Unmarshal(raw.0, &parsed)
    .map_err(|e| domain.fail(domain.ErrorKind.InvalidRequest, e.Error()))?
  Ok(
    domain.ImageSpec {
      id: parsed.id,
      cluster_name: parsed.cluster_name,
      image: parsed.image,
    },
  )
}

pub fn decode_verification(raw: json.RawMessage) -> domain.VerificationSpec {
  let mut parsed = VerificationPropsRaw { .. }
  let _ = json.Unmarshal(raw.0, &parsed)
  domain.VerificationSpec { cluster_name: parsed.cluster_name }
}

pub fn decode_resume(
  raw: json.RawMessage,
) -> Result<domain.ResumeSpec, domain.Failure> {
  let mut parsed = ResumePropsRaw { .. }
  json
    .Unmarshal(raw.0, &parsed)
    .map_err(|e| domain.fail(domain.ErrorKind.InvalidRequest, e.Error()))?
  Ok(
    domain.ResumeSpec {
      id: parsed.id,
      cluster_name: parsed.cluster_name,
      nonce: parsed.nonce,
    },
  )
}
