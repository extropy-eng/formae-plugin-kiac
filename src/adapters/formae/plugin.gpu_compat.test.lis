import "go:context"
import "go:github.com/platform-engineering-labs/formae/pkg/plugin/resource"

#[test("the SDK create path enables GPU compatibility")]
fn sdk_create_gpu_compat() -> Result<(), error> {
  let log_file = temp_file("args")?
  let path = fake_kiac(f"printf '%s\\n' \"$*\" >> {log_file}")?
  let mut plugin = plugin_with_kiac(path)
  let request = resource.CreateRequest {
    ResourceType: TYPE_GPU_COMPAT,
    Label: "",
    Properties: raw_message(
      "{
        \"clusterName\": \"dev\",
        \"namespace\": \"default\",
        \"enabled\": true,
        \"rotateCertificate\": true
      }",
    ),
    TargetConfig: target_for(path),
  }
  let result = plugin.Create(context.Background(), &request)?
  let Some(progress) = result.ProgressResult else {
    assert false
    return Ok(())
  }
  assert progress.NativeID == "dev/default"
  let seen = read_text(log_file)?
  assert seen.contains(
    "gpu compat enable --name dev --namespace default --rotate-certificate",
  )
  Ok(())
}

#[test("the SDK read path omits GPU write-only fields")]
fn sdk_read_gpu_compat_omits_write_only_fields() -> Result<(), error> {
  let mut plugin = plugin_with_kiac("/bin/true")
  let request = resource.ReadRequest {
    NativeID: "dev/default",
    ResourceType: TYPE_GPU_COMPAT,
    TargetConfig: raw_message("{}"),
    PriorProperties: raw_message(""),
  }
  let result = plugin.Read(context.Background(), &request)?
  assert result.ErrorCode == resource.OperationErrorCodeNotSet
  assert result.Properties.contains("\"namespace\":\"default\"")
  assert !result.Properties.contains("enabled")
  assert !result.Properties.contains("rotateCertificate")
  Ok(())
}

#[test("the SDK update path disables GPU compatibility")]
fn sdk_update_gpu_compat() -> Result<(), error> {
  let log_file = temp_file("args")?
  let path = fake_kiac(f"printf '%s\\n' \"$*\" >> {log_file}")?
  let mut plugin = plugin_with_kiac(path)
  let request = resource.UpdateRequest {
    NativeID: "dev/default",
    ResourceType: TYPE_GPU_COMPAT,
    Label: "",
    PriorProperties: raw_message("{}"),
    DesiredProperties: raw_message(
      "{
        \"clusterName\": \"dev\",
        \"namespace\": \"default\",
        \"enabled\": false
      }",
    ),
    PatchDocument: None,
    TargetConfig: target_for(path),
  }
  let result = plugin.Update(context.Background(), &request)?
  let Some(progress) = result.ProgressResult else {
    assert false
    return Ok(())
  }
  assert progress.NativeID == "dev/default"
  let seen = read_text(log_file)?
  assert seen.contains("gpu compat disable --name dev --namespace default")
  assert !seen.contains("rotate")
  Ok(())
}

#[test("the SDK delete path disables GPU compatibility")]
fn sdk_delete_gpu_compat() -> Result<(), error> {
  let log_file = temp_file("args")?
  let path = fake_kiac(f"printf '%s\\n' \"$*\" >> {log_file}")?
  let mut plugin = plugin_with_kiac(path)
  let request = resource.DeleteRequest {
    NativeID: "dev/default",
    ResourceType: TYPE_GPU_COMPAT,
    TargetConfig: target_for(path),
  }
  let result = plugin.Delete(context.Background(), &request)?
  let Some(progress) = result.ProgressResult else {
    assert false
    return Ok(())
  }
  assert progress.Operation == resource.OperationDelete
  let seen = read_text(log_file)?
  assert seen.contains("gpu compat disable --name dev --namespace default")
  Ok(())
}

#[test("GPU delete does not reject a malformed target")]
fn gpu_delete_ignores_bad_target() -> Result<(), error> {
  let mut plugin = plugin_with_kiac("/bin/true")
  let request = resource.DeleteRequest {
    NativeID: "dev/default",
    ResourceType: TYPE_GPU_COMPAT,
    TargetConfig: raw_message("{"),
  }
  let result = plugin.Delete(context.Background(), &request)?
  let Some(progress) = result.ProgressResult else {
    assert false
    return Ok(())
  }
  assert progress.ErrorCode != resource.OperationErrorCodeInvalidRequest
  Ok(())
}
