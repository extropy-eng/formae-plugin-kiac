import "go:context"
import "go:github.com/platform-engineering-labs/formae/pkg/model"
import "go:github.com/platform-engineering-labs/formae/pkg/plugin/resource"

import "application"
import "domain"

pub const TYPE_CLUSTER = "KIAC::Cluster::Cluster"

pub const TYPE_NODE = "KIAC::Cluster::Node"

pub const TYPE_GPU_COMPAT = "KIAC::GPU::Compat"

pub const TYPE_IMAGE = "KIAC::Cluster::Image"

pub const TYPE_VERIFICATION = "KIAC::Cluster::Verification"

pub const TYPE_RESUME = "KIAC::Cluster::Resume"

pub struct Plugin { app: mut application.Application }

fn unsupported(resource_type: string) -> domain.Failure {
  domain.fail(
    domain.ErrorKind.InvalidRequest,
    f"unsupported resource type: {resource_type}",
  )
}

impl Plugin {
  pub fn new(app: mut application.Application) -> mut Plugin {
    Plugin { app }
  }

  #[allow(non_snake_case_function)]
  pub fn RateLimit(self) -> model.RateLimitConfig {
    model.RateLimitConfig {
      Scope: model.RateLimitScopeNamespace,
      MaxRequestsPerSecondForNamespace: 1,
    }
  }

  #[allow(non_snake_case_function)]
  pub fn DiscoveryFilters(self) -> Slice<model.MatchFilter> {
    []
  }

  #[allow(non_snake_case_function)]
  pub fn LabelConfig(self) -> model.LabelConfig {
    model.LabelConfig { .. }
  }

  #[allow(non_snake_case_function)]
  pub fn Create(
    self: mut Ref<Plugin>,
    ctx: context.Context,
    request: Ref<resource.CreateRequest>,
  ) -> Result<mut Ref<resource.CreateResult>, error> {
    match request.ResourceType {
      TYPE_CLUSTER => {
        let target = match parse_target(request.TargetConfig) {
          Ok(target) => target,
          Err(failure) => return Ok(create_failure(failure)),
        }
        let spec = match decode_cluster_props(request.Properties) {
          Ok(spec) => spec,
          Err(failure) => return Ok(create_failure(failure)),
        }
        match self.app.create_cluster(ctx, target, spec) {
          Ok(outcome) => Ok(create_result(outcome, encode_properties)),
          Err(failure) => Ok(create_failure(failure)),
        }
      },
      TYPE_NODE => {
        let target = match parse_target(request.TargetConfig) {
          Ok(target) => target,
          Err(failure) => return Ok(create_failure(failure)),
        }
        let spec = match decode_node_props(request.Properties) {
          Ok(spec) => spec,
          Err(failure) => return Ok(create_failure(failure)),
        }
        match self.app.create_node(ctx, target, spec) {
          Ok(outcome) => Ok(create_result(outcome, encode_properties)),
          Err(failure) => Ok(create_failure(failure)),
        }
      },
      TYPE_GPU_COMPAT => {
        let target = match parse_target(request.TargetConfig) {
          Ok(target) => target,
          Err(failure) => return Ok(create_failure(failure)),
        }
        let spec = match decode_gpu_compat(request.Properties) {
          Ok(spec) => spec,
          Err(failure) => return Ok(create_failure(failure)),
        }
        match self.app.create_gpu_compat(ctx, target, spec) {
          Ok(outcome) => Ok(create_result(outcome, encode_properties)),
          Err(failure) => Ok(create_failure(failure)),
        }
      },
      TYPE_IMAGE => {
        let target = match parse_target(request.TargetConfig) {
          Ok(target) => target,
          Err(failure) => return Ok(create_failure(failure)),
        }
        let spec = match decode_image(request.Properties) {
          Ok(spec) => spec,
          Err(failure) => return Ok(create_failure(failure)),
        }
        match self.app.create_image(ctx, target, spec) {
          Ok(outcome) => Ok(create_result(outcome, encode_properties)),
          Err(failure) => Ok(create_failure(failure)),
        }
      },
      TYPE_VERIFICATION => {
        let spec = decode_verification(request.Properties)
        match self.app.create_verification(spec) {
          Ok(outcome) => Ok(create_result(outcome, encode_properties)),
          Err(failure) => Ok(create_failure(failure)),
        }
      },
      _ => Ok(create_failure(unsupported(request.ResourceType))),
    }
  }

  #[allow(non_snake_case_function)]
  pub fn Read(
    self: mut Ref<Plugin>,
    ctx: context.Context,
    request: Ref<resource.ReadRequest>,
  ) -> Result<mut Ref<resource.ReadResult>, error> {
    match request.ResourceType {
      TYPE_CLUSTER => {
        let target = match parse_target(request.TargetConfig) {
          Ok(target) => target,
          Err(failure) => {
            return Ok(read_failure(TYPE_CLUSTER, failure.kind))
          },
        }
        match self.app.read_cluster(ctx, target, request.NativeID) {
          Ok(properties) => Ok(read_success(
            TYPE_CLUSTER,
            encode_properties(properties),
          )),
          Err(failure) => Ok(read_failure(TYPE_CLUSTER, failure.kind)),
        }
      },
      TYPE_NODE => {
        let target = match parse_target(request.TargetConfig) {
          Ok(target) => target,
          Err(failure) => {
            return Ok(read_failure(TYPE_NODE, failure.kind))
          },
        }
        match self.app.read_node(ctx, target, request.NativeID) {
          Ok(properties) => Ok(read_success(
            TYPE_NODE,
            encode_properties(properties),
          )),
          Err(failure) => Ok(read_failure(TYPE_NODE, failure.kind)),
        }
      },
      TYPE_GPU_COMPAT => {
        match self.app.read_gpu_compat(request.NativeID) {
          Ok(properties) => Ok(read_success(
            TYPE_GPU_COMPAT,
            encode_properties(properties),
          )),
          Err(failure) => Ok(read_failure(TYPE_GPU_COMPAT, failure.kind)),
        }
      },
      TYPE_IMAGE => {
        match self.app.read_image(request.NativeID) {
          Ok(properties) => Ok(read_success(
            TYPE_IMAGE,
            encode_properties(properties),
          )),
          Err(failure) => Ok(read_failure(TYPE_IMAGE, failure.kind)),
        }
      },
      TYPE_VERIFICATION => {
        let target = match parse_target(request.TargetConfig) {
          Ok(target) => target,
          Err(failure) => {
            return Ok(read_failure(TYPE_VERIFICATION, failure.kind))
          },
        }
        match self.app.read_verification(ctx, target, request.NativeID) {
          Ok(properties) => Ok(read_success(
            TYPE_VERIFICATION,
            encode_properties(properties),
          )),
          Err(failure) => Ok(read_failure(TYPE_VERIFICATION, failure.kind)),
        }
      },
      _ => Ok(read_failure(
        request.ResourceType,
        domain.ErrorKind.InvalidRequest,
      )),
    }
  }

  #[allow(non_snake_case_function)]
  pub fn Update(
    self: mut Ref<Plugin>,
    ctx: context.Context,
    request: Ref<resource.UpdateRequest>,
  ) -> Result<mut Ref<resource.UpdateResult>, error> {
    match request.ResourceType {
      TYPE_NODE => {
        let target = match parse_target(request.TargetConfig) {
          Ok(target) => target,
          Err(failure) => return Ok(update_failure(failure)),
        }
        let prior = decode_prior_node(request.PriorProperties)
        let desired = match decode_node_props(request.DesiredProperties) {
          Ok(desired) => desired,
          Err(failure) => return Ok(update_failure(failure)),
        }
        match self.app.update_node(
          ctx,
          target,
          request.NativeID,
          prior,
          desired,
        ) {
          Ok(outcome) => Ok(update_result(outcome, encode_properties)),
          Err(failure) => Ok(update_failure(failure)),
        }
      },
      TYPE_GPU_COMPAT => {
        let target = match parse_target(request.TargetConfig) {
          Ok(target) => target,
          Err(failure) => return Ok(update_failure(failure)),
        }
        let desired = decode_desired_gpu_compat(request.DesiredProperties)
        match self.app.update_gpu_compat(ctx, target, request.NativeID, desired) {
          Ok(outcome) => Ok(update_result(outcome, encode_properties)),
          Err(failure) => Ok(update_failure(failure)),
        }
      },
      _ => Ok(update_failure(domain.fail(
        domain.ErrorKind.NotUpdatable,
        f"unsupported resource type: {request.ResourceType}",
      ))),
    }
  }

  #[allow(non_snake_case_function)]
  pub fn Delete(
    self: mut Ref<Plugin>,
    ctx: context.Context,
    request: Ref<resource.DeleteRequest>,
  ) -> Result<mut Ref<resource.DeleteResult>, error> {
    match request.ResourceType {
      TYPE_CLUSTER => {
        let target = match parse_target(request.TargetConfig) {
          Ok(target) => target,
          Err(failure) => return Ok(delete_failure(failure)),
        }
        match self.app.delete_cluster(ctx, target, request.NativeID) {
          Ok(outcome) => Ok(delete_result(outcome)),
          Err(failure) => Ok(delete_failure(failure)),
        }
      },
      TYPE_NODE => {
        let outcome = match self.app.delete_node(request.NativeID) {
          Ok(outcome) => outcome,
          Err(failure) => return Ok(delete_failure(failure)),
        }
        Ok(delete_result(outcome))
      },
      TYPE_GPU_COMPAT => {
        let target = match parse_target(request.TargetConfig) {
          Ok(target) => target,
          Err(failure) => return Ok(delete_failure(failure)),
        }
        match self.app.delete_gpu_compat(ctx, target, request.NativeID) {
          Ok(outcome) => Ok(delete_result(outcome)),
          Err(failure) => Ok(delete_failure(failure)),
        }
      },
      TYPE_IMAGE => {
        let outcome = match self.app.delete_image(request.NativeID) {
          Ok(outcome) => outcome,
          Err(failure) => return Ok(delete_failure(failure)),
        }
        Ok(delete_result(outcome))
      },
      TYPE_VERIFICATION => {
        let outcome = match self.app.delete_verification(request.NativeID) {
          Ok(outcome) => outcome,
          Err(failure) => return Ok(delete_failure(failure)),
        }
        Ok(delete_result(outcome))
      },
      _ => Ok(delete_failure(unsupported(request.ResourceType))),
    }
  }

  #[allow(non_snake_case_function)]
  pub fn Status(
    self: mut Ref<Plugin>,
    ctx: context.Context,
    request: Ref<resource.StatusRequest>,
  ) -> Result<mut Ref<resource.StatusResult>, error> {
    if request.ResourceType == TYPE_CLUSTER || request.ResourceType == TYPE_RESUME {
      let target = match parse_target(request.TargetConfig) {
        Ok(target) => target,
        Err(failure) => {
          return Ok(status_result(
            application.StatusOutcome.Failure { failure },
            request.*,
            encode_properties,
          ))
        },
      }
      let outcome = self.app.check_status(
        ctx,
        target,
        request.RequestID,
        request.NativeID,
      )
      return Ok(status_result(outcome, request.*, encode_properties))
    }
    Ok(status_result(
      application.StatusOutcome.Failure {
        failure: unsupported(request.ResourceType),
      },
      request.*,
      encode_properties,
    ))
  }

  #[allow(non_snake_case_function)]
  pub fn List(
    self: mut Ref<Plugin>,
    ctx: context.Context,
    request: Ref<resource.ListRequest>,
  ) -> Result<mut Ref<resource.ListResult>, error> {
    match request.ResourceType {
      TYPE_CLUSTER => {
        let target = match parse_target(request.TargetConfig) {
          Ok(target) => target,
          Err(_) => return Ok(list_result([])),
        }
        match self.app.list_clusters(ctx, target) {
          Ok(ids) => Ok(list_result(ids)),
          Err(_) => Ok(list_result([])),
        }
      },
      TYPE_NODE => {
        let target = match parse_target(request.TargetConfig) {
          Ok(target) => target,
          Err(_) => return Ok(list_result([])),
        }
        let cluster = request.AdditionalProperties.map_or("", |properties| {
          properties.get("clusterName").unwrap_or("")
        })
        match self.app.list_nodes(ctx, target, cluster) {
          Ok(ids) => Ok(list_result(ids)),
          Err(_) => Ok(list_result([])),
        }
      },
      _ => Ok(list_result([])),
    }
  }
}
