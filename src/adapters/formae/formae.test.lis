#[test("the SDK update path stops a node")]
fn sdk_update_node() -> Result<(), error> {
  let log_file = temp_file("args")?

  let path = fake_kiac(
    f"
      if [ \"$1\" = \"get\" ]; then
        echo '{two_node_cluster_json()}'
      else
        printf '%s\\n' \"$*\" >> {log_file}
      fi
    ",
  )?

  let mut plugin = plugin_with_kiac(path)
  let request = resource.UpdateRequest {
    NativeID: "dev/kiac-dev-worker-1",
    ResourceType: TYPE_NODE,
    Label: "",
    PriorProperties: raw_message("{\"state\":\"running\"}"),
    DesiredProperties: raw_message(
      "{\"clusterName\":\"dev\",\"name\":\"kiac-dev-worker-1\",\"state\":\"stopped\"}",
    ),
    PatchDocument: None,
    TargetConfig: target_for(path),
  }
  let result = plugin.Update(context.Background(), &request)?
  let Some(progress) = result.ProgressResult else {
    assert false
    return Ok(())
  }
  assert progress.NativeID == "dev/kiac-dev-worker-1"
  let seen = read_text(log_file)?
  assert seen.contains("stop node kiac-dev-worker-1 --name dev")
  Ok(())
}

#[test("GPU delete does not reject a malformed target")]
fn gpu_delete_ignores_bad_target() -> Result<(), error> {
  let mut plugin = plugin_with_kiac("/bin/true")
  let request = resource.DeleteRequest {
    NativeID: "dev/default",
    ResourceType: TYPE_GPU_COMPAT,
    TargetConfig: raw_message("{"),
  }
  let result = plugin.Delete(context.Background(), &request)?
  let Some(progress) = result.ProgressResult else {
    assert false
    return Ok(())
  }
  assert progress.ErrorCode != resource.OperationErrorCodeInvalidRequest
  Ok(())
}

#[test("node discovery accepts the cluster property")]
fn node_discovery_accepts_cluster_property() -> Result<(), error> {
  let path = fake_kiac(f"echo '{two_node_cluster_json()}'")?
  let mut plugin = plugin_with_kiac(path)
  let mut properties = Map.new<string, string>()
  properties["cluster"] = "dev"
  let request = resource.ListRequest {
    ResourceType: TYPE_NODE,
    TargetConfig: target_for(path),
    AdditionalProperties: Some(properties),
    ..,
  }
  let result = plugin.List(context.Background(), &request)?
  assert result.NativeIDs.length() == 2
  Ok(())
}

#[test("node discovery without a parent is empty")]
fn node_discovery_without_parent_is_empty() -> Result<(), error> {
  let path = fake_kiac(f"echo '{two_node_cluster_json()}'")?
  let mut plugin = plugin_with_kiac(path)
  let request = resource.ListRequest {
    ResourceType: TYPE_NODE,
    TargetConfig: target_for(path),
    ..,
  }
  let result = plugin.List(context.Background(), &request)?
  assert result.NativeIDs.is_empty()
  Ok(())
}
