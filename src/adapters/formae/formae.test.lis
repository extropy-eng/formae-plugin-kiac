import "go:github.com/platform-engineering-labs/formae/pkg/plugin/resource"

import "application"
import "domain"

fn expect_failure<T>(result: Result<T, domain.Failure>) -> domain.Failure {
  match result {
    Err(failure) => failure,
    Ok(_) => domain.fail(domain.ErrorKind.InternalFailure, "expected failure"),
  }
}

#[test("an empty target uses the default kiac path and wait values")]
fn empty_target_uses_defaults() -> Result<(), error> {
  let actual = parse_target(raw_message(""))?
  assert actual ==
  domain.TargetConfig {
    kiac_path: "kiac",
    container_path: "container",
    default_wait_seconds: 300,
    status_timeout_seconds: 10,
  }
  Ok(())
}

#[test("explicit target fields override the defaults")]
fn explicit_target_overrides_defaults() -> Result<(), error> {
  let actual = parse_target(raw_message(
    "{
      \"KiacPath\": \"/opt/kiac\",
      \"DefaultWaitSeconds\": 60,
      \"StatusTimeoutSeconds\": 3
    }",
  ))?
  assert actual ==
  domain.TargetConfig {
    kiac_path: "/opt/kiac",
    container_path: "container",
    default_wait_seconds: 60,
    status_timeout_seconds: 3,
  }
  Ok(())
}

#[test("malformed target JSON is an invalid request")]
fn malformed_target_is_invalid_request() {
  let failure = expect_failure(parse_target(raw_message("{")))
  assert failure.kind == domain.ErrorKind.InvalidRequest
  assert failure.message.starts_with("parse target config:")
}

#[test("every domain error kind maps to its formae code")]
fn error_kinds_map_to_sdk_codes() {
  assert sdk_code(domain.ErrorKind.NotFound) ==
  resource.OperationErrorCodeNotFound
  assert sdk_code(domain.ErrorKind.DependencyFailure) ==
  resource.OperationErrorCodeDependencyFailure
  assert sdk_code(domain.ErrorKind.NotUpdatable) ==
  resource.OperationErrorCodeNotUpdatable
}

#[test("an in-progress create result carries the native id and message")]
fn in_progress_create_carries_native_id() {
  let result = create_result(
    application.CreateOutcome {
      native_id: "dev",
      request_id: "dev",
      status: application.CreateStatus.InProgress,
      message: "creating cluster dev",
      properties: application.ResourceProperties.None,
    },
    |_| "",
  )
  let Some(progress) = result.ProgressResult else {
    assert false
    return
  }
  assert progress.OperationStatus == resource.OperationStatusInProgress
  assert progress.NativeID == "dev"
}

#[test("a no-op delete result uses the no-op operation")]
fn noop_delete_uses_noop_operation() {
  let result = delete_result(
    application.DeleteOutcome { native_id: "dev/n1", no_op: true },
  )
  let Some(progress) = result.ProgressResult else {
    assert false
    return
  }
  assert progress.Operation == resource.OperationNoOp
}

#[test("cluster request properties decode into a domain cluster spec")]
fn cluster_request_decodes_to_spec() -> Result<(), error> {
  let actual = decode_cluster_props(raw_message(
    "{
      \"name\": \"dev\",
      \"distro\": \"k3s\",
      \"workers\": 2,
      \"cni\": \"cilium\"
    }",
  ))?
  let expected = domain.ClusterSpec {
    name: "dev",
    distro: "k3s",
    workers: 2,
    cni: "cilium",
    ..,
  }
  assert actual.equals(expected)
  Ok(())
}

#[test("node request properties decode into a domain node spec")]
fn node_request_decodes_to_spec() -> Result<(), error> {
  let actual = decode_node_props(raw_message(
    "{
      \"id\": \"dev/cp\",
      \"clusterName\": \"dev\",
      \"name\": \"cp\",
      \"state\": \"stopped\"
    }",
  ))?
  assert actual ==
  domain.NodeSpec {
    id: "dev/cp",
    cluster_name: "dev",
    name: "cp",
    state: "stopped",
  }
  Ok(())
}

#[test("malformed node properties are an invalid request")]
fn malformed_node_properties_are_invalid() {
  let failure = expect_failure(decode_node_props(raw_message("{")))
  assert failure.kind == domain.ErrorKind.InvalidRequest
  assert failure.message.contains("invalid properties:")
}
