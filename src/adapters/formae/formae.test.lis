import "go:context"
import "go:encoding/json"
import "go:github.com/platform-engineering-labs/formae/pkg/plugin/resource"
import "go:time"

#[test("the SDK read path returns cluster properties")]
fn sdk_read_returns_cluster_properties() -> Result<(), error> {
  let path = fake_kiac(f"echo '{ready_cluster_json()}'")?
  let mut plugin = plugin_with_kiac(path)
  let request = resource.ReadRequest {
    NativeID: "dev",
    ResourceType: TYPE_CLUSTER,
    TargetConfig: target_for(path),
    PriorProperties: raw_message(""),
  }
  let result = plugin.Read(context.Background(), &request)?
  assert result.ErrorCode == resource.OperationErrorCodeNotSet
  assert result.Properties.contains("\"name\":\"dev\"")
  Ok(())
}

#[test("the SDK list path returns cluster native ids")]
fn sdk_list_returns_cluster_ids() -> Result<(), error> {
  let raw = "[
    {\"name\": \"a\", \"nodes\": []},
    {\"name\": \"b\", \"nodes\": []}
  ]"
  let path = fake_kiac(f"echo '{raw}'")?
  let mut plugin = plugin_with_kiac(path)
  let request = resource.ListRequest {
    ResourceType: TYPE_CLUSTER,
    TargetConfig: target_for(path),
    ..,
  }
  let result = plugin.List(context.Background(), &request)?
  assert result.NativeIDs.equals(["a", "b"])
  Ok(())
}

#[test("resume status echoes the nonce native id")]
fn resume_status_echoes_nonce_native_id() -> Result<(), error> {
  let script = f"if [ \"$1\" = \"get\" ]; then
    echo '{ready_cluster_json()}'
  else
    sleep 0.2
  fi"
  let path = fake_kiac(script)?
  let mut plugin = plugin_with_kiac(path)
  let request = resource.StatusRequest {
    RequestID: "dev",
    NativeID: "dev/n1",
    ResourceType: TYPE_RESUME,
    TargetConfig: target_for(path),
  }
  let result = plugin.Status(context.Background(), &request)?
  let Some(progress) = result.ProgressResult else {
    assert false
    return Ok(())
  }
  assert progress.NativeID == "dev/n1"
  assert progress.OperationStatus == resource.OperationStatusSuccess
  Ok(())
}

#[test("the SDK read path returns node properties")]
fn sdk_read_returns_node_properties() -> Result<(), error> {
  let path = fake_kiac(f"echo '{two_node_cluster_json()}'")?
  let mut plugin = plugin_with_kiac(path)
  let request = resource.ReadRequest {
    NativeID: "dev/kiac-dev-worker-1",
    ResourceType: TYPE_NODE,
    TargetConfig: target_for(path),
    PriorProperties: raw_message(""),
  }
  let result = plugin.Read(context.Background(), &request)?
  assert result.ErrorCode == resource.OperationErrorCodeNotSet
  let mut actual: NodeOutput = NodeOutput { .. }
  json.Unmarshal(result.Properties as Slice<byte>, &actual)?
  assert actual ==
  NodeOutput {
    id: "dev/kiac-dev-worker-1",
    cluster_name: "dev",
    name: "kiac-dev-worker-1",
    state: "running",
    ip: "10.0.0.2",
    image: "img",
    created: "2026-10-04T03:18:35Z",
  }
  Ok(())
}

