import "go:context"
import "go:encoding/json"
import "go:github.com/platform-engineering-labs/formae/pkg/model"
import "go:github.com/platform-engineering-labs/formae/pkg/plugin/resource"
import "go:os"
import "go:path/filepath"

import "adapters/kiac"
import "application"
import "domain"

fn expect_failure<T>(result: Result<T, domain.Failure>) -> domain.Failure {
  match result {
    Err(failure) => failure,
    Ok(_) => domain.fail(domain.ErrorKind.InternalFailure, "expected failure"),
  }
}

#[test("an empty target uses the default kiac path and wait values")]
fn empty_target_uses_defaults() -> Result<(), error> {
  let actual = parse_target(raw_message(""))?
  assert actual ==
  domain.TargetConfig {
    kiac_path: "kiac",
    container_path: "container",
    default_wait_seconds: 300,
    status_timeout_seconds: 10,
  }
  Ok(())
}

#[test("explicit target fields override the defaults")]
fn explicit_target_overrides_defaults() -> Result<(), error> {
  let actual = parse_target(raw_message(
    "{
      \"KiacPath\": \"/opt/kiac\",
      \"DefaultWaitSeconds\": 60,
      \"StatusTimeoutSeconds\": 3
    }",
  ))?
  assert actual ==
  domain.TargetConfig {
    kiac_path: "/opt/kiac",
    container_path: "container",
    default_wait_seconds: 60,
    status_timeout_seconds: 3,
  }
  Ok(())
}

#[test("malformed target JSON is an invalid request")]
fn malformed_target_is_invalid_request() {
  let failure = expect_failure(parse_target(raw_message("{")))
  assert failure.kind == domain.ErrorKind.InvalidRequest
  assert failure.message.starts_with("parse target config:")
}

#[test("every domain error kind maps to its formae code")]
fn error_kinds_map_to_sdk_codes() {
  assert sdk_code(domain.ErrorKind.NotFound) ==
  resource.OperationErrorCodeNotFound
  assert sdk_code(domain.ErrorKind.DependencyFailure) ==
  resource.OperationErrorCodeDependencyFailure
  assert sdk_code(domain.ErrorKind.NotUpdatable) ==
  resource.OperationErrorCodeNotUpdatable
}

#[test("an in-progress create result carries the native id and message")]
fn in_progress_create_carries_native_id() {
  let result = create_result(
    application.CreateOutcome {
      native_id: "dev",
      request_id: "dev",
      status: application.CreateStatus.InProgress,
      message: "creating cluster dev",
      properties: application.ResourceProperties.None,
    },
    |_| "",
  )
  let Some(progress) = result.ProgressResult else {
    assert false
    return
  }
  assert progress.OperationStatus == resource.OperationStatusInProgress
  assert progress.NativeID == "dev"
}

#[test("a no-op delete result uses the no-op operation")]
fn noop_delete_uses_noop_operation() {
  let result = delete_result(
    application.DeleteOutcome { native_id: "dev/n1", no_op: true },
  )
  let Some(progress) = result.ProgressResult else {
    assert false
    return
  }
  assert progress.Operation == resource.OperationNoOp
}

#[test("cluster request properties decode into a domain cluster spec")]
fn cluster_request_decodes_to_spec() -> Result<(), error> {
  let actual = decode_cluster_props(raw_message(
    "{
      \"name\": \"dev\",
      \"distro\": \"k3s\",
      \"workers\": 2,
      \"cni\": \"cilium\"
    }",
  ))?
  let expected = domain.ClusterSpec {
    name: "dev",
    distro: "k3s",
    workers: 2,
    cni: "cilium",
    ..,
  }
  assert actual.equals(expected)
  Ok(())
}

#[test("node request properties decode into a domain node spec")]
fn node_request_decodes_to_spec() -> Result<(), error> {
  let actual = decode_node_props(raw_message(
    "{
      \"id\": \"dev/cp\",
      \"clusterName\": \"dev\",
      \"name\": \"cp\",
      \"state\": \"stopped\"
    }",
  ))?
  assert actual ==
  domain.NodeSpec {
    id: "dev/cp",
    cluster_name: "dev",
    name: "cp",
    state: "stopped",
  }
  Ok(())
}

#[test("malformed node properties are an invalid request")]
fn malformed_node_properties_are_invalid() {
  let failure = expect_failure(decode_node_props(raw_message("{")))
  assert failure.kind == domain.ErrorKind.InvalidRequest
  assert failure.message.contains("invalid properties:")
}

fn ready_cluster() -> domain.Cluster {
  domain.Cluster {
    name: "dev",
    status: "2/2 running",
    running_nodes: 2,
    total_nodes: 2,
    k8s_version: "v1.37.0-k3s1",
    created: "2026-10-04T03:18:35Z",
    nodes: [],
  }
}

#[test("cluster read properties include observed fields")]
fn cluster_read_properties_include_observed_fields() -> Result<(), error> {
  let text = encode_properties(application.ResourceProperties.Cluster(
    ready_cluster(),
  ))
  let mut actual: ClusterOutput = ClusterOutput { .. }
  json.Unmarshal(text as Slice<byte>, &actual)?
  let expected = ClusterOutput {
    name: "dev",
    status: "2/2 running",
    running_nodes: 2,
    total_nodes: 2,
    installed_k8s_version: "v1.37.0-k3s1",
    created: "2026-10-04T03:18:35Z",
    nodes: [],
  }
  assert actual.equals(expected)
  Ok(())
}

#[test("GPU compatibility read properties omit write-only fields")]
fn gpu_compat_read_omits_write_only_fields() {
  let text = encode_properties(application.ResourceProperties.GpuCompatState(
    domain.GpuCompatState {
      id: "dev/default",
      cluster_name: "dev",
      namespace: "default",
    },
  ))
  assert text.contains("\"namespace\":\"default\"")
  assert !text.contains("enabled")
  assert !text.contains("rotateCertificate")
}

#[test("node read properties include the parent cluster and node state")]
fn node_read_properties_include_parent_and_state() -> Result<(), error> {
  let text = encode_properties(
    application.ResourceProperties.Node {
      cluster: "dev",
      node: domain.Node {
        name: "cp",
        state: "running",
        ip: "10.0.0.1",
        image: "img",
        created: "2026-10-04T03:18:35Z",
      },
    },
  )
  let mut actual: NodeOutput = NodeOutput { .. }
  json.Unmarshal(text as Slice<byte>, &actual)?
  assert actual ==
  NodeOutput {
    id: "dev/cp",
    cluster_name: "dev",
    name: "cp",
    state: "running",
    ip: "10.0.0.1",
    image: "img",
    created: "2026-10-04T03:18:35Z",
  }
  Ok(())
}

fn plugin_with_kiac(_path: string) -> mut Plugin {
  let cli = kiac.KiacCli { .. }
  Plugin.new(application.new(cli, cli, cli, cli, cli, cli))
}

#[test("the plugin advertises namespace-scoped rate limiting")]
fn plugin_advertises_namespace_rate_limit() {
  let plugin = plugin_with_kiac("/bin/true")
  let rate_limit = plugin.RateLimit()
  assert rate_limit.Scope == model.RateLimitScopeNamespace
  assert rate_limit.MaxRequestsPerSecondForNamespace == 1
}

#[test("an unsupported read resource type is an invalid request")]
fn unsupported_read_is_invalid_request() -> Result<(), error> {
  let mut plugin = plugin_with_kiac("/bin/true")
  let request = resource.ReadRequest {
    NativeID: "dev",
    ResourceType: "KIAC::Unknown",
    TargetConfig: raw_message("{}"),
    PriorProperties: raw_message(""),
  }
  let result = plugin.Read(context.Background(), &request)?
  assert result.ErrorCode == resource.OperationErrorCodeInvalidRequest
  Ok(())
}

fn ready_cluster_json() -> string {
  "{
    \"name\": \"dev\",
    \"status\": \"2/2 running\",
    \"runningNodes\": 2,
    \"totalNodes\": 2,
    \"k8sVersion\": \"v1.37.0-k3s1\",
    \"created\": \"2026-10-04T03:18:35Z\",
    \"nodes\": []
  }"
}

fn target_for(path: string) -> mut json.RawMessage {
  raw_message(f"{{\"KiacPath\":\"{path}\"}}")
}

#[test("the SDK read path returns cluster properties")]
fn sdk_read_returns_cluster_properties() -> Result<(), error> {
  let path = fake_kiac(f"echo '{ready_cluster_json()}'")?
  let mut plugin = plugin_with_kiac(path)
  let request = resource.ReadRequest {
    NativeID: "dev",
    ResourceType: TYPE_CLUSTER,
    TargetConfig: target_for(path),
    PriorProperties: raw_message(""),
  }
  let result = plugin.Read(context.Background(), &request)?
  assert result.ErrorCode == resource.OperationErrorCodeNotSet
  assert result.Properties.contains("\"name\":\"dev\"")
  Ok(())
}

fn fake_kiac(body: string) -> Result<string, error> {
  let dir = os.MkdirTemp("", "kiac-test")?
  let path = filepath.Join(dir, "kiac")
  os.WriteFile(path, (f"#!/bin/sh\n{body}") as Slice<byte>, 0o755)?
  Ok(path)
}

#[test("the SDK list path returns cluster native ids")]
fn sdk_list_returns_cluster_ids() -> Result<(), error> {
  let raw = "[
    {\"name\": \"a\", \"nodes\": []},
    {\"name\": \"b\", \"nodes\": []}
  ]"
  let path = fake_kiac(f"echo '{raw}'")?
  let mut plugin = plugin_with_kiac(path)
  let request = resource.ListRequest {
    ResourceType: TYPE_CLUSTER,
    TargetConfig: target_for(path),
    ..,
  }
  let result = plugin.List(context.Background(), &request)?
  assert result.NativeIDs.equals(["a", "b"])
  Ok(())
}

#[test("resume status echoes the nonce native id")]
fn resume_status_echoes_nonce_native_id() -> Result<(), error> {
  let script = f"if [ \"$1\" = \"get\" ]; then
    echo '{ready_cluster_json()}'
  else
    sleep 0.2
  fi"
  let path = fake_kiac(script)?
  let mut plugin = plugin_with_kiac(path)
  let request = resource.StatusRequest {
    RequestID: "dev",
    NativeID: "dev/n1",
    ResourceType: TYPE_RESUME,
    TargetConfig: target_for(path),
  }
  let result = plugin.Status(context.Background(), &request)?
  let Some(progress) = result.ProgressResult else {
    assert false
    return Ok(())
  }
  assert progress.NativeID == "dev/n1"
  assert progress.OperationStatus == resource.OperationStatusSuccess
  Ok(())
}

fn two_node_cluster_json() -> string {
  "{
    \"name\": \"dev\",
    \"status\": \"2/2 running\",
    \"runningNodes\": 2,
    \"totalNodes\": 2,
    \"k8sVersion\": \"v1.37.0-k3s1\",
    \"created\": \"2026-10-04T03:18:35Z\",
    \"nodes\": [
      {
        \"name\": \"kiac-dev-control-plane\",
        \"state\": \"running\",
        \"ip\": \"10.0.0.1\",
        \"image\": \"img\",
        \"created\": \"2026-10-04T03:18:35Z\"
      },
      {
        \"name\": \"kiac-dev-worker-1\",
        \"state\": \"running\",
        \"ip\": \"10.0.0.2\",
        \"image\": \"img\",
        \"created\": \"2026-10-04T03:18:35Z\"
      }
    ]
  }"
}

#[test("the SDK read path returns node properties")]
fn sdk_read_returns_node_properties() -> Result<(), error> {
  let path = fake_kiac(f"echo '{two_node_cluster_json()}'")?
  let mut plugin = plugin_with_kiac(path)
  let request = resource.ReadRequest {
    NativeID: "dev/kiac-dev-worker-1",
    ResourceType: TYPE_NODE,
    TargetConfig: target_for(path),
    PriorProperties: raw_message(""),
  }
  let result = plugin.Read(context.Background(), &request)?
  assert result.ErrorCode == resource.OperationErrorCodeNotSet
  let mut actual: NodeOutput = NodeOutput { .. }
  json.Unmarshal(result.Properties as Slice<byte>, &actual)?
  assert actual ==
  NodeOutput {
    id: "dev/kiac-dev-worker-1",
    cluster_name: "dev",
    name: "kiac-dev-worker-1",
    state: "running",
    ip: "10.0.0.2",
    image: "img",
    created: "2026-10-04T03:18:35Z",
  }
  Ok(())
}

#[test("the SDK delete path treats a node as a no-op")]
fn sdk_delete_node_is_noop() -> Result<(), error> {
  let mut plugin = plugin_with_kiac("/bin/true")
  let request = resource.DeleteRequest {
    NativeID: "dev/cp",
    ResourceType: TYPE_NODE,
    TargetConfig: raw_message("{}"),
  }
  let result = plugin.Delete(context.Background(), &request)?
  let Some(progress) = result.ProgressResult else {
    assert false
    return Ok(())
  }
  assert progress.Operation == resource.OperationNoOp
  Ok(())
}

#[test("the SDK list path returns node native ids")]
fn sdk_list_returns_node_ids() -> Result<(), error> {
  let path = fake_kiac(f"echo '{two_node_cluster_json()}'")?
  let mut plugin = plugin_with_kiac(path)
  let mut properties = Map.new<string, string>()
  properties["clusterName"] = "dev"
  let request = resource.ListRequest {
    ResourceType: TYPE_NODE,
    TargetConfig: target_for(path),
    AdditionalProperties: Some(properties),
    ..,
  }
  let result = plugin.List(context.Background(), &request)?
  let expected = ["dev/kiac-dev-control-plane", "dev/kiac-dev-worker-1"]
  assert result.NativeIDs.equals(expected)
  Ok(())
}

fn temp_file(name: string) -> Result<string, error> {
  let dir = os.MkdirTemp("", "kiac-test")?
  Ok(filepath.Join(dir, name))
}

fn read_text(path: string) -> Result<string, error> {
  Ok((os.ReadFile(path)?) as string)
}

#[test("the SDK create path enables GPU compatibility")]
fn sdk_create_gpu_compat() -> Result<(), error> {
  let log_file = temp_file("args")?
  let path = fake_kiac(f"printf '%s\\n' \"$*\" >> {log_file}")?
  let mut plugin = plugin_with_kiac(path)
  let request = resource.CreateRequest {
    ResourceType: TYPE_GPU_COMPAT,
    Label: "",
    Properties: raw_message(
      "{
        \"clusterName\": \"dev\",
        \"namespace\": \"default\",
        \"enabled\": true,
        \"rotateCertificate\": true
      }",
    ),
    TargetConfig: target_for(path),
  }
  let result = plugin.Create(context.Background(), &request)?
  let Some(progress) = result.ProgressResult else {
    assert false
    return Ok(())
  }
  assert progress.NativeID == "dev/default"
  let seen = read_text(log_file)?
  assert seen.contains(
    "gpu compat enable --name dev --namespace default --rotate-certificate",
  )
  Ok(())
}

#[test("the SDK read path omits GPU write-only fields")]
fn sdk_read_gpu_compat_omits_write_only_fields() -> Result<(), error> {
  let mut plugin = plugin_with_kiac("/bin/true")
  let request = resource.ReadRequest {
    NativeID: "dev/default",
    ResourceType: TYPE_GPU_COMPAT,
    TargetConfig: raw_message("{}"),
    PriorProperties: raw_message(""),
  }
  let result = plugin.Read(context.Background(), &request)?
  assert result.ErrorCode == resource.OperationErrorCodeNotSet
  assert result.Properties.contains("\"namespace\":\"default\"")
  assert !result.Properties.contains("enabled")
  assert !result.Properties.contains("rotateCertificate")
  Ok(())
}

#[test("the SDK update path disables GPU compatibility")]
fn sdk_update_gpu_compat() -> Result<(), error> {
  let log_file = temp_file("args")?
  let path = fake_kiac(f"printf '%s\\n' \"$*\" >> {log_file}")?
  let mut plugin = plugin_with_kiac(path)
  let request = resource.UpdateRequest {
    NativeID: "dev/default",
    ResourceType: TYPE_GPU_COMPAT,
    Label: "",
    PriorProperties: raw_message("{}"),
    DesiredProperties: raw_message(
      "{
        \"clusterName\": \"dev\",
        \"namespace\": \"default\",
        \"enabled\": false
      }",
    ),
    PatchDocument: None,
    TargetConfig: target_for(path),
  }
  let result = plugin.Update(context.Background(), &request)?
  let Some(progress) = result.ProgressResult else {
    assert false
    return Ok(())
  }
  assert progress.NativeID == "dev/default"
  let seen = read_text(log_file)?
  assert seen.contains("gpu compat disable --name dev --namespace default")
  assert !seen.contains("rotate")
  Ok(())
}

#[test("the SDK delete path disables GPU compatibility")]
fn sdk_delete_gpu_compat() -> Result<(), error> {
  let log_file = temp_file("args")?
  let path = fake_kiac(f"printf '%s\\n' \"$*\" >> {log_file}")?
  let mut plugin = plugin_with_kiac(path)
  let request = resource.DeleteRequest {
    NativeID: "dev/default",
    ResourceType: TYPE_GPU_COMPAT,
    TargetConfig: target_for(path),
  }
  let result = plugin.Delete(context.Background(), &request)?
  let Some(progress) = result.ProgressResult else {
    assert false
    return Ok(())
  }
  assert progress.Operation == resource.OperationDelete
  let seen = read_text(log_file)?
  assert seen.contains("gpu compat disable --name dev --namespace default")
  Ok(())
}

#[test("the SDK create path loads an image")]
fn sdk_create_image() -> Result<(), error> {
  let log_file = temp_file("args")?
  let path = fake_kiac(f"printf '%s\\n' \"$*\" >> {log_file}")?
  let mut plugin = plugin_with_kiac(path)
  let request = resource.CreateRequest {
    ResourceType: TYPE_IMAGE,
    Label: "",
    Properties: raw_message(
      "{
        \"id\": \"dev/myapp:latest\",
        \"clusterName\": \"dev\",
        \"image\": \"myapp:latest\"
      }",
    ),
    TargetConfig: target_for(path),
  }
  let result = plugin.Create(context.Background(), &request)?
  let Some(progress) = result.ProgressResult else {
    assert false
    return Ok(())
  }
  assert progress.NativeID == "dev/myapp:latest"
  let seen = read_text(log_file)?
  assert seen.contains("load image myapp:latest --name dev")
  Ok(())
}

