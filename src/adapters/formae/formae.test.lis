#[test("the SDK create path loads an image")]
fn sdk_create_image() -> Result<(), error> {
  let log_file = temp_file("args")?
  let path = fake_kiac(f"printf '%s\\n' \"$*\" >> {log_file}")?
  let mut plugin = plugin_with_kiac(path)
  let request = resource.CreateRequest {
    ResourceType: TYPE_IMAGE,
    Label: "",
    Properties: raw_message(
      "{
        \"id\": \"dev/myapp:latest\",
        \"clusterName\": \"dev\",
        \"image\": \"myapp:latest\"
      }",
    ),
    TargetConfig: target_for(path),
  }
  let result = plugin.Create(context.Background(), &request)?
  let Some(progress) = result.ProgressResult else {
    assert false
    return Ok(())
  }
  assert progress.NativeID == "dev/myapp:latest"
  let seen = read_text(log_file)?
  assert seen.contains("load image myapp:latest --name dev")
  Ok(())
}

#[test("the SDK read path echoes the image")]
fn sdk_read_image_echoes_declared_value() -> Result<(), error> {
  let mut plugin = plugin_with_kiac("/bin/true")
  let request = resource.ReadRequest {
    NativeID: "dev/myapp:latest",
    ResourceType: TYPE_IMAGE,
    TargetConfig: raw_message(""),
    PriorProperties: raw_message(""),
  }
  let result = plugin.Read(context.Background(), &request)?
  assert result.ErrorCode == resource.OperationErrorCodeNotSet
  let mut actual: ImageOutput = ImageOutput { .. }
  json.Unmarshal(result.Properties as Slice<byte>, &actual)?
  assert actual ==
  ImageOutput {
    id: "dev/myapp:latest",
    cluster_name: "dev",
    image: "myapp:latest",
  }
  Ok(())
}

