import "go:context"
import "go:encoding/json"
import "go:github.com/platform-engineering-labs/formae/pkg/plugin/resource"
import "go:os"
import "go:path/filepath"

#[test("parsing an empty raw JSON target produces a target with default values")]
fn target_defaults() -> Result<(), error> {
  let actual = parse_target(raw_message(""))?
  let expected = TargetConfig {
    kiac_path: "kiac",
    container_path: "container",
    default_wait_seconds: 300,
    status_timeout_seconds: 10,
  }
  assert actual == expected
  Ok(())
}

#[test("parsing a raw JSON target produces a target with overridden values")]
fn target_overrides() -> Result<(), error> {
  let expected = TargetConfig {
    kiac_path: "/opt/kiac",
    container_path: "/usr/bin/container",
    default_wait_seconds: 60,
    status_timeout_seconds: 3,
  }
  let actual = parse_target(json.RawMessage(json.Marshal(expected)?))?
  assert actual == expected
  Ok(())
}

#[test("unmarshalling a raw JSON target produces a TargetConfig")]
fn unmarshall_target_config() -> Result<(), error> {
  let raw = raw_message(
    "{
      \"KiacPath\": \"/opt/kiac\",
      \"ContainerPath\": \"/usr/bin/container\",
      \"DefaultWaitSeconds\": 60,
      \"StatusTimeoutSeconds\": 3
   }",
  )
  let mut parsed = TargetConfig { .. }
  json.Unmarshal(raw.0, &parsed)?

  assert parsed ==
  TargetConfig {
    kiac_path: "/opt/kiac",
    container_path: "/usr/bin/container",
    default_wait_seconds: 60,
    status_timeout_seconds: 3,
  }
  Ok(())
}

#[test("split id on the first slash")]
fn split_id_on_first_slash() {
  assert split_id("dev/worker") == ("dev", "worker")
}

#[test("split id when slash is missing")]
fn split_id_when_slash_is_missing() {
  assert split_id("dev") == ("", "dev")
}

#[test("classify kiac operation error: AlreadyExists")]
fn classify_cluster_already_exists() {
  assert classify_error("cluster already exists") ==
  resource.OperationErrorCodeAlreadyExists
}

#[test("classify kiac operation error: NotFound")]
fn classify_cluster_not_found() {
  assert classify_error("no such cluster") ==
  resource.OperationErrorCodeNotFound
}

#[test("classify kiac operation error: ServiceTimeout")]
fn classify_service_timeout() {
  assert classify_error("timed out waiting for ready") ==
  resource.OperationErrorCodeServiceTimeout
}

#[test("classify kiac operation error: AccessDenied")]
fn classify_access_denied() {
  assert classify_error("permission denied") ==
  resource.OperationErrorCodeAccessDenied
}

#[test("classify kiac operation error: ServiceException")]
fn classify_unknown_error() {
  assert classify_error("unexpected") ==
  resource.OperationErrorCodeGeneralServiceException
}

/// Write an executable fake `kiac` and return its absolute path.
fn fake_kiac(body: string) -> Result<string, error> {
  let dir = os.MkdirTemp("", "kiac-test")?
  let path = filepath.Join(dir, "kiac")
  os.WriteFile(path, (f"#!/bin/sh\n{body}") as Slice<byte>, 0o755)?
  Ok(path)
}

#[test("running the fake kiac captures stdout")]
fn run_fake_kiac_captures_stdout() -> Result<(), error> {
  let target = TargetConfig {
    kiac_path: fake_kiac("echo 'greetings from kiac'")?,
    container_path: "container",
    default_wait_seconds: 300,
    status_timeout_seconds: 10,
  }
  let result = run_kiac(context.Background(), target, [])?
  assert result.stdout == "greetings from kiac\n"
  Ok(())
}

#[test("running the fake kiac captures stderr")]
fn run_fake_kiac_captures_stderr() -> Result<(), error> {
  let target = TargetConfig {
    kiac_path: fake_kiac("echo 'cluster not found' >&2; exit 1")?,
    container_path: "container",
    default_wait_seconds: 300,
    status_timeout_seconds: 10,
  }

  assert run_kiac(context.Background(), target, []) ==
  Err(
    Failure {
      code: resource.OperationErrorCodeNotFound,
      message: "cluster not found",
    },
  )
  Ok(())
}

#[test("list clusters parses a JSON array of clusters")]
fn list_clusters_parses_a_non_empty_response() -> Result<(), error> {
  let clusters = [
    KiacCluster { name: "staging", .. },
    KiacCluster { name: "prod", .. },
  ]
  let actual = list_clusters(
    context.Background(),
    TargetConfig {
      kiac_path: fake_kiac(f"echo '{json.Marshal(clusters)? as string}'")?,
      ..,
    },
  )?
  assert actual.equals(clusters)
  Ok(())
}

#[test("list clusters parses an empty JSON array")]
fn list_clusters_parses_an_empty_response() -> Result<(), error> {
  let clusters = list_clusters(
    context.Background(),
    TargetConfig { kiac_path: fake_kiac("printf '[]'")?, .. },
  )?
  assert clusters.is_empty()
  Ok(())
}

#[test("unmarshall a raw JSON array of clusters")]
fn unmarshall_clusters() -> Result<(), error> {
  let raw_clusters = "[
    {
      \"name\": \"dev\",
      \"status\": \"2/2 running\",
      \"runningNodes\": 2,
      \"totalNodes\": 2,
      \"k8sVersion\": \"v1.37.0-k3s1\",
      \"created\": \"2026-10-04T03:18:35Z\",
      \"nodes\": [
        {
          \"name\": \"cp\",
          \"state\": \"running\",
          \"ip\": \"10.0.0.1\",
          \"image\": \"img\",
          \"created\": \"2026-10-04T03:18:35Z\"
        }
      ]
    }
  ]"

  let mut parsed = [KiacCluster { .. }]
  json.Unmarshal(raw_clusters as Slice<byte>, &parsed)?

  assert parsed.equals([
    KiacCluster {
      name: "dev",
      status: "2/2 running",
      running_nodes: 2,
      total_nodes: 2,
      k8s_version: "v1.37.0-k3s1",
      created: "2026-10-04T03:18:35Z",
      nodes: [
        KiacNode {
          name: "cp",
          state: "running",
          ip: "10.0.0.1",
          image: "img",
          created: "2026-10-04T03:18:35Z",
        },
      ],
    },
  ])
  Ok(())
}
